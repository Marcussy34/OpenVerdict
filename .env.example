# --- GonkaRouter (server-side only; never NEXT_PUBLIC_) ---
GONKA_ROUTER_BASE_URL=https://api.gonkarouter.io/v1
GONKA_ROUTER_API_KEY=sk-your-key
# verified live limits: output hard cap 4096 tokens, ~1000 req/min sustained
GONKA_REQUEST_TIMEOUT_MS=120000
# research turns (juror search/open loop) carry a growing conversation; default 240 s
GONKA_RESEARCH_TIMEOUT_MS=240000
GONKA_MAX_RETRIES=1
# hedged requests: repeat a call to the same model after this many ms (0 disables)
GONKA_HEDGE_AFTER_MS=25000

# --- Walrus writes from constrained hosts (optional) ---
# Upload relay so a small container does not fan a blob out to ~100 nodes;
# testnet: https://upload-relay.testnet.walrus.space (tip 105 MIST per upload)
WALRUS_UPLOAD_RELAY_URL=
WALRUS_UPLOAD_RELAY_MAX_TIP_MIST=1000

# --- Juror research (server-side only; required when gonka.mode is live) ---
# Firecrawl v2 REST key for the engine's search/open loop; use a dedicated account.
FIRECRAWL_API_KEY=fc-your-key
# cloud default; point at a self-hosted Firecrawl (http://firecrawl:3002) to run without credits
FIRECRAWL_API_URL=https://api.firecrawl.dev

# --- Sui ---
SUI_NETWORK=localnet
SUI_RPC_URL=http://127.0.0.1:9000
# release manifest is the source of truth for package/object ids:
OPENVERDICT_RELEASE_MANIFEST=config/release.localnet.json
# optional gRPC fullnode override (defaults to the manifest's suiRpcUrl)
OPENVERDICT_SUI_GRPC_URL=
# operator key for lifecycle transactions (bech32 suiprivkey...); never commit real keys
SUI_OPERATOR_SECRET_KEY=

# --- Storage ---
# leave DATABASE_URL empty to use embedded pglite at .pglite/ (local only);
# production uses Railway Postgres through the ${{Postgres.DATABASE_URL}} reference
DATABASE_URL=
# postgres example: postgresql://openverdict:openverdict@localhost:5432/openverdict
# pglite data directory when DATABASE_URL is empty (must be writable)
PGLITE_DATA_DIR=.pglite

# --- Workers ---
# poll interval while no claim is live (2 s while one is); submissions touch the wake file
OPENVERDICT_WORKER_IDLE_POLL_MS=15000
# wake file path (defaults to <tmpdir>/openverdict-wake)
OPENVERDICT_WAKE_FILE=

# --- Walrus ---
WALRUS_NETWORK=testnet
# local mode writes content-addressed blobs under .localnet/walrus-local

# --- App ---
NEXT_PUBLIC_SUI_NETWORK=localnet
NEXT_PUBLIC_WRITE_MODE=disabled

# --- API write guards ---
# Public fact-check/evidence submissions stay 403 until explicitly enabled:
OPENVERDICT_PUBLIC_WRITES=enabled
# Operator-only routes (claim create) need this bearer token (>=16 chars):
OPENVERDICT_OPERATOR_TOKEN=
# Set to 1 ONLY when deployed behind a trusted proxy that sets x-forwarded-for:
OPENVERDICT_TRUST_PROXY=0

# --- Enoki zkLogin onboarding (optional; testnet/mainnet only) ---
# Get an API key at the Enoki dev portal; create a Google OAuth client for the app URL.
# When unset, social login is hidden and standard wallets still work.
NEXT_PUBLIC_ENOKI_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Engine runtime (required to wire the engine) ---
# Deterministic TEST-ONLY seed deriving the 5 demo agent keypairs:
OPENVERDICT_AGENT_SEED=
# Optional distinct challenger signer (falls back to operator):
SUI_CHALLENGER_SECRET_KEY=
