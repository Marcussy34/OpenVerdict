# --- GonkaRouter (server-side only; never NEXT_PUBLIC_) ---
GONKA_ROUTER_BASE_URL=https://api.gonkarouter.io/v1
GONKA_ROUTER_API_KEY=sk-your-key
# verified live limits: output hard cap 4096 tokens, ~1000 req/min sustained
GONKA_REQUEST_TIMEOUT_MS=120000
# research turns (juror search/open loop) carry a growing conversation; default 240 s
GONKA_RESEARCH_TIMEOUT_MS=240000
GONKA_MAX_RETRIES=1
# hedged requests: repeat a call to the same model after this many ms (0 disables)
GONKA_HEDGE_AFTER_MS=25000

# --- Walrus writes from constrained hosts (optional) ---
# Upload relay so a small container does not fan a blob out to ~100 nodes;
# testnet: https://upload-relay.testnet.walrus.space (tip 105 MIST per upload)
WALRUS_UPLOAD_RELAY_URL=
WALRUS_UPLOAD_RELAY_MAX_TIP_MIST=1000
# Walrus writer lanes derived from OPENVERDICT_AGENT_SEED: each one signs its
# own register and certify transactions, so parallel uploads stop queueing on
# the operator's coins. 0 disables the pool and every write uses the operator.
# Fund them with `pnpm walrus:writers --fund` (0.3 SUI and 0.5 WAL each).
OPENVERDICT_WALRUS_WRITERS=4
# WAL coin type override; derived from the Walrus staking module when unset.
WALRUS_WAL_COIN_TYPE=

# --- Juror research (server-side only; required when gonka.mode is live) ---
# Firecrawl v2 REST key for the engine's search/open loop; use a dedicated account.
FIRECRAWL_API_KEY=fc-your-key
# cloud default; point at a self-hosted Firecrawl (http://firecrawl:3002) to run without credits
FIRECRAWL_API_URL=https://api.firecrawl.dev

# --- Sui ---
SUI_NETWORK=localnet
SUI_RPC_URL=http://127.0.0.1:9000
# release manifest is the source of truth for package/object ids:
OPENVERDICT_RELEASE_MANIFEST=config/release.localnet.json
# optional gRPC fullnode override (defaults to the manifest's suiRpcUrl)
OPENVERDICT_SUI_GRPC_URL=
# operator key for lifecycle transactions (bech32 suiprivkey...); never commit real keys
SUI_OPERATOR_SECRET_KEY=
# Shinami Gas Station: OpenVerdict pays the gas for wallet-signed pool entries.
# Server-side only (the gas station refuses CORS). Leave empty to make users pay
# their own gas; check the fund with `pnpm sponsor:check`.
SHINAMI_GAS_ACCESS_KEY=
# region endpoint override; defaults to https://api.us1.shinami.com/sui/gas/v1
SHINAMI_GAS_ENDPOINT=

# --- Storage ---
# leave DATABASE_URL empty to use embedded pglite at .pglite/ (local only);
# production uses Railway Postgres through the ${{Postgres.DATABASE_URL}} reference
DATABASE_URL=
# postgres example: postgresql://openverdict:openverdict@localhost:5432/openverdict
# pglite data directory when DATABASE_URL is empty (must be writable)
PGLITE_DATA_DIR=.pglite

# --- Workers ---
# poll interval while a claim is live, and while none is; submissions touch the wake file
OPENVERDICT_WORKER_POLL_MS=2000
OPENVERDICT_WORKER_IDLE_POLL_MS=15000
# wake file path (defaults to <tmpdir>/openverdict-wake)
OPENVERDICT_WAKE_FILE=
# Which of the operator's SUI coins this process pays with, so the workers and
# the web never equivocate one coin. start-production.mjs sets 0, 1, 2 for the
# three workers and 3 for the web; unset keeps the old shared-coin behaviour.
# `pnpm walrus:writers --split-gas 3` creates the coins the slots need.
OPENVERDICT_OPERATOR_GAS_SLOT=
# Advisory tick lock name; defaults to the worker's own name, so each role
# ticks independently and two replicas of one role still exclude each other.
OPENVERDICT_TICK_LOCK_NAME=
# Time reserved before the discussion deadline for the phase-two freeze. Only
# the fallback bound: a converged debate freezes as soon as it settles.
OPENVERDICT_EVIDENCE_FREEZE_LEAD_MS=30000

# --- Walrus ---
WALRUS_NETWORK=testnet
# local mode writes content-addressed blobs under .localnet/walrus-local

# --- App ---
NEXT_PUBLIC_SUI_NETWORK=localnet
NEXT_PUBLIC_WRITE_MODE=disabled
# Console origin, e.g. https://app.openverdict.info. When set, the header hands
# visitors to it, the proxy redirects console paths there and www to the apex.
# Leave empty for one host or local development.
NEXT_PUBLIC_APP_URL=
# Canonical landing origin for metadata, robots, and the sitemap. Defaults to
# https://openverdict.info.
NEXT_PUBLIC_SITE_URL=
# Documentation origin, e.g. https://docs.openverdict.info. When set, links to
# the docs point there; unset they stay in-app at /docs, which every host
# serves either way. The proxy rewrites a `docs.` host to /docs regardless.
NEXT_PUBLIC_DOCS_URL=

# --- API write guards ---
# Public fact-check/evidence submissions stay 403 until explicitly enabled:
OPENVERDICT_PUBLIC_WRITES=enabled
# Operator-only routes (claim create) need this bearer token (>=16 chars):
OPENVERDICT_OPERATOR_TOKEN=
# Set to 1 ONLY when deployed behind a trusted proxy that sets x-forwarded-for:
OPENVERDICT_TRUST_PROXY=0

# --- zkLogin verification (engine) ---
# GraphQL endpoint used to verify zkLogin signatures for agent registration
# (defaults per network; set for localnet)
OPENVERDICT_ZKLOGIN_GRAPHQL_URL=

# --- Enoki zkLogin onboarding (optional; testnet/mainnet only) ---
# Get an API key at the Enoki dev portal; create a Google OAuth client for the app URL.
# When unset, social login is hidden and standard wallets still work.
NEXT_PUBLIC_ENOKI_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Engine runtime (required to wire the engine) ---
# Deterministic TEST-ONLY seed deriving the 5 demo agent keypairs:
OPENVERDICT_AGENT_SEED=
# Operational signing slots derived from the seed (default 16, minimum 7).
# Slots 0 to 6 belong to the demo agents; every further slot can take a staked
# seat. Each slot address is a pure function of the seed and its index, so
# raising this number never moves an existing seat.
OPENVERDICT_AGENT_SLOTS=16
# The old signed-message registration lets the OPERATOR post the bond, so it is
# off unless set to "enabled". Real seats stake 0.1 SUI through
# /api/agents/stake/prepare and /api/agents/stake/confirm instead.
OPENVERDICT_FREE_SEATS=
# Optional distinct challenger signer (falls back to operator):
SUI_CHALLENGER_SECRET_KEY=
