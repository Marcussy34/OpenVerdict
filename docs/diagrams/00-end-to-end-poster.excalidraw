    { "type": "rectangle", "id": "pr_container", "x": 1420, "y": 2000, "width": 520, "height": 80, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 700027, "version": 1, "versionNonce": 700028, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "pr_container_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "pr_container_t", "x": 1430, "y": 2010, "width": 500, "height": 60, "text": "EXPECTED: one container (Dockerfile / railway.json)\nnode scripts/start-production.mjs = next start + the 3 workers,\nhealthcheck /api/status, any child death restarts the service", "originalText": "EXPECTED: one container (Dockerfile / railway.json)\nnode scripts/start-production.mjs = next start + the 3 workers,\nhealthcheck /api/status, any child death restarts the service", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 700029, "version": 1, "versionNonce": 700030, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "pr_container", "lineHeight": 1.25 },
    { "type": "text", "id": "pr_fix", "x": 1420, "y": 2095, "width": 1100, "height": 65, "text": "the two can coexist: keep Vercel for the site and run ONLY the workers somewhere else against the same\nDATABASE_URL and env. Options: (a) a Railway / Fly / Render container from the Dockerfile; (b) a laptop for the\ndemo window: DATABASE_URL=<neon> pnpm tsx workers/<name>-worker.ts x3; (c) a Vercel Cron hitting a tick route\nis fragile: a single tick can hold one 120 s model call per juror, longer than a function is meant to live.", "originalText": "the two can coexist: keep Vercel for the site and run ONLY the workers somewhere else against the same\nDATABASE_URL and env. Options: (a) a Railway / Fly / Render container from the Dockerfile; (b) a laptop for the\ndemo window: DATABASE_URL=<neon> pnpm tsx workers/<name>-worker.ts x3; (c) a Vercel Cron hitting a tick route\nis fragile: a single tick can hold one 120 s model call per juror, longer than a function is meant to live.", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 700031, "version": 1, "versionNonce": 700032, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

