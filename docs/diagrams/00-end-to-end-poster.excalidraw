    { "type": "ellipse", "id": "sp1_dot", "x": 90, "y": 190, "width": 20, "height": 20, "strokeColor": "#c2410c", "backgroundColor": "#fed7aa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100041, "version": 1, "versionNonce": 100042, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false },
    { "type": "text", "id": "sp1_t", "x": 20, "y": 222, "width": 160, "height": 52, "text": "1 SUBMIT\nPOST /api/fact-checks\nno wallet, rate-limited", "originalText": "1 SUBMIT\nPOST /api/fact-checks\nno wallet, rate-limited", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100043, "version": 1, "versionNonce": 100044, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "ellipse", "id": "sp2_dot", "x": 416, "y": 190, "width": 20, "height": 20, "strokeColor": "#1e3a5f", "backgroundColor": "#3b82f6", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100045, "version": 1, "versionNonce": 100046, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false },
    { "type": "text", "id": "sp2_t", "x": 316, "y": 222, "width": 220, "height": 52, "text": "2 CLAIM ON SUI\nshared Claim object, mode\nDIRECT_REVIEW, state u8 = 3", "originalText": "2 CLAIM ON SUI\nshared Claim object, mode\nDIRECT_REVIEW, state u8 = 3", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100047, "version": 1, "versionNonce": 100048, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "ellipse", "id": "sp3_dot", "x": 742, "y": 190, "width": 20, "height": 20, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100049, "version": 1, "versionNonce": 100050, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false },
    { "type": "text", "id": "sp3_t", "x": 632, "y": 222, "width": 240, "height": 52, "text": "3 FREEZE EVIDENCE\nSSRF-safe fetch, Walrus blobs,\nMerkle root pinned on Sui", "originalText": "3 FREEZE EVIDENCE\nSSRF-safe fetch, Walrus blobs,\nMerkle root pinned on Sui", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100051, "version": 1, "versionNonce": 100052, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "ellipse", "id": "sp4_dot", "x": 1068, "y": 190, "width": 20, "height": 20, "strokeColor": "#1e3a5f", "backgroundColor": "#3b82f6", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100053, "version": 1, "versionNonce": 100054, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false },
    { "type": "text", "id": "sp4_t", "x": 958, "y": 222, "width": 240, "height": 52, "text": "4 DRAW 5 SEATS\nSui Random (0x8), 3+ model\nfamilies, max 2 seats per model", "originalText": "4 DRAW 5 SEATS\nSui Random (0x8), 3+ model\nfamilies, max 2 seats per model", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100055, "version": 1, "versionNonce": 100056, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "ellipse", "id": "sp5_dot", "x": 1394, "y": 190, "width": 20, "height": 20, "strokeColor": "#6d28d9", "backgroundColor": "#ddd6fe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100057, "version": 1, "versionNonce": 100058, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false },
    { "type": "text", "id": "sp5_t", "x": 1284, "y": 222, "width": 240, "height": 52, "text": "5 FIVE INFERENCES\nsame frozen bundle, no peer\nvisibility, strict JSON output", "originalText": "5 FIVE INFERENCES\nsame frozen bundle, no peer\nvisibility, strict JSON output", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100059, "version": 1, "versionNonce": 100060, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "ellipse", "id": "sp6_dot", "x": 1720, "y": 190, "width": 20, "height": 20, "strokeColor": "#1e3a5f", "backgroundColor": "#3b82f6", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100061, "version": 1, "versionNonce": 100062, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false },
    { "type": "text", "id": "sp6_t", "x": 1610, "y": 222, "width": 240, "height": 52, "text": "6 COMMIT (sealed)\nblake2b256 of vote + salt on\nthe agent's own JurySeat", "originalText": "6 COMMIT (sealed)\nblake2b256 of vote + salt on\nthe agent's own JurySeat", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100063, "version": 1, "versionNonce": 100064, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "ellipse", "id": "sp7_dot", "x": 2046, "y": 190, "width": 20, "height": 20, "strokeColor": "#1e3a5f", "backgroundColor": "#3b82f6", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100065, "version": 1, "versionNonce": 100066, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false },
    { "type": "text", "id": "sp7_t", "x": 1936, "y": 222, "width": 240, "height": 52, "text": "7 REVEAL + TALLY\nMove recomputes the hash,\nRoundTally needs 4 of 5", "originalText": "7 REVEAL + TALLY\nMove recomputes the hash,\nRoundTally needs 4 of 5", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100067, "version": 1, "versionNonce": 100068, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "ellipse", "id": "sp8_dot", "x": 2370, "y": 190, "width": 20, "height": 20, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100069, "version": 1, "versionNonce": 100070, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false },
    { "type": "text", "id": "sp8_t", "x": 2260, "y": 222, "width": 240, "height": 52, "text": "8 CERTIFICATE\nfrozen ResolutionCertificate,\nTruth Score anyone can recompute", "originalText": "8 CERTIFICATE\nfrozen ResolutionCertificate,\nTruth Score anyone can recompute", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100071, "version": 1, "versionNonce": 100072, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "eng_room", "x": 760, "y": 330, "width": 860, "height": 1240, "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300001, "version": 1, "versionNonce": 300002, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "eng_room_title", "x": 780, "y": 342, "width": 820, "height": 25, "text": "LEVEL 2: THE ENGINE (lib/engine, one singleton per process)", "originalText": "LEVEL 2: THE ENGINE (lib/engine, one singleton per process)", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300003, "version": 1, "versionNonce": 300004, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "eng_hero", "x": 790, "y": 385, "width": 800, "height": 80, "strokeColor": "#1e3a5f", "backgroundColor": "#3b82f6", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300005, "version": 1, "versionNonce": 300006, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "eng_hero_t", "type": "text" }, { "id": "cx_api", "type": "arrow" }, { "id": "cx_gonka", "type": "arrow" }, { "id": "cx_sui", "type": "arrow" }, { "id": "cx_walrus", "type": "arrow" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "eng_hero_t", "x": 800, "y": 400, "width": 780, "height": 50, "text": "OpenVerdictEngine  (createEngine in lib/engine/engine.ts)\nthe court clerk: signs as the operator, keeps the salts, never decides the answer", "originalText": "OpenVerdictEngine  (createEngine in lib/engine/engine.ts)\nthe court clerk: signs as the operator, keeps the salts, never decides the answer", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300007, "version": 1, "versionNonce": 300008, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "eng_hero", "lineHeight": 1.25 },

    { "type": "text", "id": "eng_seam_note", "x": 790, "y": 478, "width": 800, "height": 20, "text": "The seam is lib/engine/contract.ts. Its methods split cleanly into two halves:", "originalText": "The seam is lib/engine/contract.ts. Its methods split cleanly into two halves:", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300009, "version": 1, "versionNonce": 300010, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "eng_req_title", "x": 790, "y": 508, "width": 380, "height": 20, "text": "REQUEST SIDE (called by app/api routes)", "originalText": "REQUEST SIDE (called by app/api routes)", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#3b82f6", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300011, "version": 1, "versionNonce": 300012, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "eng_req_list", "x": 790, "y": 534, "width": 380, "height": 158, "text": "factCheckStart  create Claim on Sui + ingest URLs\nclaimCreate     operator-only economic claims\nlistClaims / inspect / report\nevents          SSE async generator\nlistAgents\nregisterZkBackedAgent  zkLogin-backed seat\nstatus          what /api/status returns\n\nall of these RETURN QUICKLY; none advance a claim", "originalText": "factCheckStart  create Claim on Sui + ingest URLs\nclaimCreate     operator-only economic claims\nlistClaims / inspect / report\nevents          SSE async generator\nlistAgents\nregisterZkBackedAgent  zkLogin-backed seat\nstatus          what /api/status returns\n\nall of these RETURN QUICKLY; none advance a claim", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300013, "version": 1, "versionNonce": 300014, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "line", "id": "eng_split_line", "x": 1190, "y": 508, "width": 0, "height": 184, "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300015, "version": 1, "versionNonce": 300016, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "points": [[0, 0], [0, 184]] },
    { "type": "text", "id": "eng_life_title", "x": 1210, "y": 508, "width": 380, "height": 20, "text": "LIFECYCLE SIDE (workers / CLI only)", "originalText": "LIFECYCLE SIDE (workers / CLI only)", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#3b82f6", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300017, "version": 1, "versionNonce": 300018, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "eng_life_list", "x": 1210, "y": 534, "width": 400, "height": 147, "text": "selectCommittee  draw 5 seats with Sui Random\nevidenceFreeze   fetch -> Walrus -> Merkle -> Sui\njuryRun          5 GonkaRouter calls + validation\nvotesCommit      hash(vote, salt) on each JurySeat\nvotesReveal      preimage on chain, tally\nadvance          next phase (deadline-gated)\nfinalize         certificate + Truth Score\n\neach signs Sui transactions with the operator key", "originalText": "selectCommittee  draw 5 seats with Sui Random\nevidenceFreeze   fetch -> Walrus -> Merkle -> Sui\njuryRun          5 GonkaRouter calls + validation\nvotesCommit      hash(vote, salt) on each JurySeat\nvotesReveal      preimage on chain, tally\nadvance          next phase (deadline-gated)\nfinalize         certificate + Truth Score\n\neach signs Sui transactions with the operator key", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300019, "version": 1, "versionNonce": 300020, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "wk_title", "x": 790, "y": 720, "width": 800, "height": 20, "text": "WHO CALLS THE LIFECYCLE SIDE: three workers, each a poll loop (workers/runtime.ts)", "originalText": "WHO CALLS THE LIFECYCLE SIDE: three workers, each a poll loop (workers/runtime.ts)", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#3b82f6", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300021, "version": 1, "versionNonce": 300022, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "wk_ev", "x": 790, "y": 760, "width": 250, "height": 60, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300023, "version": 1, "versionNonce": 300024, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "wk_ev_t", "type": "text" }, { "id": "wk_arrow_1", "type": "arrow" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "wk_ev_t", "x": 800, "y": 770, "width": 230, "height": 40, "text": "evidence-worker.ts\nengine.evidenceFreeze", "originalText": "evidence-worker.ts\nengine.evidenceFreeze", "fontSize": 16, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300025, "version": 1, "versionNonce": 300026, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "wk_ev", "lineHeight": 1.25 },
    { "type": "text", "id": "wk_ev_d", "x": 790, "y": 830, "width": 250, "height": 54, "text": "picks claims that still need a\nphase-1 or phase-2 bundle;\nfetching stays inside the engine", "originalText": "picks claims that still need a\nphase-1 or phase-2 bundle;\nfetching stays inside the engine", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300027, "version": 1, "versionNonce": 300028, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "arrow", "id": "wk_arrow_1", "x": 1042, "y": 790, "width": 20, "height": 0, "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300029, "version": 1, "versionNonce": 300030, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "points": [[0, 0], [20, 0]], "startBinding": { "elementId": "wk_ev", "focus": 0, "gap": 2 }, "endBinding": { "elementId": "wk_inf", "focus": 0, "gap": 2 }, "startArrowhead": null, "endArrowhead": "arrow" },

    { "type": "rectangle", "id": "wk_inf", "x": 1065, "y": 760, "width": 250, "height": 60, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300031, "version": 1, "versionNonce": 300032, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "wk_inf_t", "type": "text" }, { "id": "wk_arrow_1", "type": "arrow" }, { "id": "wk_arrow_2", "type": "arrow" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "wk_inf_t", "x": 1075, "y": 770, "width": 230, "height": 40, "text": "inference-worker.ts\njuryRun then votesCommit", "originalText": "inference-worker.ts\njuryRun then votesCommit", "fontSize": 16, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300033, "version": 1, "versionNonce": 300034, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "wk_inf", "lineHeight": 1.25 },
    { "type": "text", "id": "wk_inf_d", "x": 1065, "y": 830, "width": 250, "height": 54, "text": "COMMIT_1 / COMMIT_2 claims whose\nevidence root is frozen; an\ninvalid model run is NOT a vote", "originalText": "COMMIT_1 / COMMIT_2 claims whose\nevidence root is frozen; an\ninvalid model run is NOT a vote", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300035, "version": 1, "versionNonce": 300036, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "arrow", "id": "wk_arrow_2", "x": 1317, "y": 790, "width": 20, "height": 0, "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300037, "version": 1, "versionNonce": 300038, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "points": [[0, 0], [20, 0]], "startBinding": { "elementId": "wk_inf", "focus": 0, "gap": 2 }, "endBinding": { "elementId": "wk_res", "focus": 0, "gap": 2 }, "startArrowhead": null, "endArrowhead": "arrow" },

    { "type": "rectangle", "id": "wk_res", "x": 1340, "y": 760, "width": 250, "height": 60, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300039, "version": 1, "versionNonce": 300040, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "wk_res_t", "type": "text" }, { "id": "wk_arrow_2", "type": "arrow" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "wk_res_t", "x": 1350, "y": 770, "width": 230, "height": 40, "text": "resolution-worker.ts\nroutes by claim state", "originalText": "resolution-worker.ts\nroutes by claim state", "fontSize": 16, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300041, "version": 1, "versionNonce": 300042, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "wk_res", "lineHeight": 1.25 },
    { "type": "text", "id": "wk_res_d", "x": 1340, "y": 830, "width": 250, "height": 90, "text": "REVIEW_REQUESTED: selectCommittee\nCOMMIT_n: advance\nREVEAL_n: votesReveal, then\n  finalize (or advance)\nDISCUSSION: advance, else finalize", "originalText": "REVIEW_REQUESTED: selectCommittee\nCOMMIT_n: advance\nREVEAL_n: votesReveal, then\n  finalize (or advance)\nDISCUSSION: advance, else finalize", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300043, "version": 1, "versionNonce": 300044, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "arrow", "id": "wk_loop", "x": 1465, "y": 935, "width": 550, "height": 30, "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300045, "version": 1, "versionNonce": 300046, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "points": [[0, 0], [0, 30], [-550, 30], [-550, 0]], "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow" },
    { "type": "text", "id": "wk_loop_t", "x": 960, "y": 972, "width": 560, "height": 45, "text": "every tick: engine.listClaims(), then act; poll every 2 s\n(OPENVERDICT_WORKER_POLL_MS). With Postgres, pg_advisory_lock serialises\nticks across all three: one Sui operator signer, one writer at a time.", "originalText": "every tick: engine.listClaims(), then act; poll every 2 s\n(OPENVERDICT_WORKER_POLL_MS). With Postgres, pg_advisory_lock serialises\nticks across all three: one Sui operator signer, one writer at a time.", "fontSize": 12, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300047, "version": 1, "versionNonce": 300048, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "wk_warn", "x": 790, "y": 1040, "width": 800, "height": 120, "strokeColor": "#dc2626", "backgroundColor": "#fee2e2", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300049, "version": 1, "versionNonce": 300050, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "wk_warn_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "wk_warn_t", "x": 800, "y": 1050, "width": 780, "height": 100, "text": "NOT RUNNING IN PRODUCTION TODAY\nThe workers are launched only by scripts/start-production.mjs (Dockerfile / railway.json).\nVercel runs only the request side: no cron, no tick route. A claim submitted on openverdict.info is\ncreated on Sui, its evidence ingested, then waits at REVIEW_REQUESTED until a worker host exists.", "originalText": "NOT RUNNING IN PRODUCTION TODAY\nThe workers are launched only by scripts/start-production.mjs (Dockerfile / railway.json).\nVercel runs only the request side: no cron, no tick route. A claim submitted on openverdict.info is\ncreated on Sui, its evidence ingested, then waits at REVIEW_REQUESTED until a worker host exists.", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#b91c1c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300051, "version": 1, "versionNonce": 300052, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "wk_warn", "lineHeight": 1.25 },

    { "type": "rectangle", "id": "db_box", "x": 790, "y": 1200, "width": 380, "height": 70, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300053, "version": 1, "versionNonce": 300054, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "db_box_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "db_box_t", "x": 800, "y": 1210, "width": 360, "height": 50, "text": "Neon Postgres (drizzle, lib/storage)\nDATABASE_URL; PGlite fallback for dev/tests", "originalText": "Neon Postgres (drizzle, lib/storage)\nDATABASE_URL; PGlite fallback for dev/tests", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300055, "version": 1, "versionNonce": 300056, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "db_box", "lineHeight": 1.25 },
    { "type": "text", "id": "db_note", "x": 790, "y": 1280, "width": 380, "height": 72, "text": "the engine's private working memory: claim\nmirror, committee, run audits, the append-only\nresolution_events log (what the SSE reads), and\nvote_packages.salt_hex: the commit-reveal salts", "originalText": "the engine's private working memory: claim\nmirror, committee, run audits, the append-only\nresolution_events log (what the SSE reads), and\nvote_packages.salt_hex: the commit-reveal salts", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300057, "version": 1, "versionNonce": 300058, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "sse_box", "x": 1210, "y": 1200, "width": 380, "height": 70, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300059, "version": 1, "versionNonce": 300060, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "sse_box_t", "type": "text" }, { "id": "cx_sse", "type": "arrow" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "sse_box_t", "x": 1220, "y": 1210, "width": 360, "height": 50, "text": "event stream (lib/events)\nengine.events(claimId, fromSequence)", "originalText": "event stream (lib/events)\nengine.events(claimId, fromSequence)", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300061, "version": 1, "versionNonce": 300062, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "sse_box", "lineHeight": 1.25 },
    { "type": "text", "id": "sse_note", "x": 1210, "y": 1280, "width": 380, "height": 72, "text": "polls resolution_events and serialises each\nrow via serializePublicEvent: PUBLIC_NOW is\nsent, PUBLIC_AFTER_REVEAL waits for the\nreveal, INTERNAL_REDACTED never leaves", "originalText": "polls resolution_events and serialises each\nrow via serializePublicEvent: PUBLIC_NOW is\nsent, PUBLIC_AFTER_REVEAL waits for the\nreveal, INTERNAL_REDACTED never leaves", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300063, "version": 1, "versionNonce": 300064, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "eng_fail", "x": 790, "y": 1380, "width": 800, "height": 160, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300065, "version": 1, "versionNonce": 300066, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "eng_fail_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "eng_fail_t", "x": 806, "y": 1392, "width": 768, "height": 136, "text": "// hard rules the engine enforces (CLAUDE.md + PRD)\nmodels never receive URLs, keys, or transaction authority   // the engine fetches; the model only reads\nsalts never leave the engine                  // vote_packages.salt_hex; never on Sui or Walrus\nmalformed model output is never a vote        // zod; cited evidenceIds must exist in the frozen manifest\nthe observer has NO signer                    // it cannot move funds, vote, or advance phases\nu8 state codes: one shared Move/TS wire contract; never renumber one side alone\n   CREATED=0 PROPOSED=1 CHALLENGED=2 REVIEW_REQUESTED=3 COMMIT_1=4 REVEAL_1=5 DISCUSSION=6 COMMIT_2=7\n   REVEAL_2=8 FINALIZED_UNCHALLENGED=9 FINALIZED_REVIEWED=10 UNRESOLVED=11 CANCELLED=12", "originalText": "// hard rules the engine enforces (CLAUDE.md + PRD)\nmodels never receive URLs, keys, or transaction authority   // the engine fetches; the model only reads\nsalts never leave the engine                  // vote_packages.salt_hex; never on Sui or Walrus\nmalformed model output is never a vote        // zod; cited evidenceIds must exist in the frozen manifest\nthe observer has NO signer                    // it cannot move funds, vote, or advance phases\nu8 state codes: one shared Move/TS wire contract; never renumber one side alone\n   CREATED=0 PROPOSED=1 CHALLENGED=2 REVIEW_REQUESTED=3 COMMIT_1=4 REVEAL_1=5 DISCUSSION=6 COMMIT_2=7\n   REVEAL_2=8 FINALIZED_UNCHALLENGED=9 FINALIZED_REVIEWED=10 UNRESOLVED=11 CANCELLED=12", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300067, "version": 1, "versionNonce": 300068, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "eng_fail", "lineHeight": 1.25 },

    { "type": "rectangle", "id": "sf_room", "x": 40, "y": 330, "width": 660, "height": 1240, "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200001, "version": 1, "versionNonce": 200002, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "sf_room_title", "x": 60, "y": 342, "width": 620, "height": 25, "text": "LEVEL 2: SURFACES (app/ on Vercel, cli/ headless)", "originalText": "LEVEL 2: SURFACES (app/ on Vercel, cli/ headless)", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200003, "version": 1, "versionNonce": 200004, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "ellipse", "id": "sf_person", "x": 60, "y": 385, "width": 260, "height": 64, "strokeColor": "#c2410c", "backgroundColor": "#fed7aa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200005, "version": 1, "versionNonce": 200006, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "sf_person_t", "type": "text" }], "link": null, "locked": false },
    { "type": "text", "id": "sf_person_t", "x": 80, "y": 397, "width": 220, "height": 40, "text": "a person with a claim\nno account, no wallet", "originalText": "a person with a claim\nno account, no wallet", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200007, "version": 1, "versionNonce": 200008, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "sf_person", "lineHeight": 1.25 },
    { "type": "text", "id": "sf_person_note", "x": 340, "y": 392, "width": 340, "height": 51, "text": "types a statement (5..1000 chars), optional\ntext (<=20k) and up to 5 https:// URLs;\nnothing else is asked of them", "originalText": "types a statement (5..1000 chars), optional\ntext (<=20k) and up to 5 https:// URLs;\nnothing else is asked of them", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200009, "version": 1, "versionNonce": 200010, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "sf_web_title", "x": 60, "y": 470, "width": 620, "height": 20, "text": "https://openverdict.info   Next.js 16, 15 page routes", "originalText": "https://openverdict.info   Next.js 16, 15 page routes", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#3b82f6", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200011, "version": 1, "versionNonce": 200012, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "line", "id": "sf_tree_line", "x": 70, "y": 500, "width": 0, "height": 228, "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200013, "version": 1, "versionNonce": 200014, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "points": [[0, 0], [0, 228]] },
    { "type": "text", "id": "sf_tree_text", "x": 84, "y": 496, "width": 600, "height": 228, "text": "/             landing: globe hero, live stat card, FAQ, footer\n/app          console home (reachable, but not in the nav)\n/fact-check   the submit form -> POST /api/fact-checks\n/claims       docket, one card per claim\n/claims/[id]  report: verdict, Truth Score, jurors, hashes\n/claims/[id]/observe   live agent lanes fed by SSE\n/evidence/[id]         the frozen evidence bundle\n/agents       jury registry + zkLogin \"back an agent\"\n/agents/[id]  one juror: model, role, manifest hashes\n/verify       recompute commitments + Truth Score in-browser\n/status       human view of /api/status\n/learn        explainer, linked from only two places\n/privacy  /terms  /risk\nnav chips: Fact-check  Claims  Agents  Verify  Status", "originalText": "/             landing: globe hero, live stat card, FAQ, footer\n/app          console home (reachable, but not in the nav)\n/fact-check   the submit form -> POST /api/fact-checks\n/claims       docket, one card per claim\n/claims/[id]  report: verdict, Truth Score, jurors, hashes\n/claims/[id]/observe   live agent lanes fed by SSE\n/evidence/[id]         the frozen evidence bundle\n/agents       jury registry + zkLogin \"back an agent\"\n/agents/[id]  one juror: model, role, manifest hashes\n/verify       recompute commitments + Truth Score in-browser\n/status       human view of /api/status\n/learn        explainer, linked from only two places\n/privacy  /terms  /risk\nnav chips: Fact-check  Claims  Agents  Verify  Status", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200015, "version": 1, "versionNonce": 200016, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "sf_api_title", "x": 60, "y": 750, "width": 620, "height": 20, "text": "app/api   thin routes; every one starts with getServerEngine()", "originalText": "app/api   thin routes; every one starts with getServerEngine()", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#3b82f6", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200017, "version": 1, "versionNonce": 200018, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "sf_api_text", "x": 60, "y": 776, "width": 620, "height": 163, "text": "GET  /api/status                        open\nGET  /api/agents                        open\nGET  /api/claims   /api/claims/[id]     open\nGET  /api/claims/[id]/report            open\nGET  /api/claims/[id]/events   (SSE)    open, resumes from a sequence number\nPOST /api/fact-checks    factCheckStart          PUBLIC_WRITES + rate limit\nPOST /api/evidence       evidence submission     PUBLIC_WRITES + rate limit\nPOST /api/agents/register  registerZkBackedAgent  zkLogin signature check\nPOST /api/claims         claimCreate             Bearer operator token", "originalText": "GET  /api/status                        open\nGET  /api/agents                        open\nGET  /api/claims   /api/claims/[id]     open\nGET  /api/claims/[id]/report            open\nGET  /api/claims/[id]/events   (SSE)    open, resumes from a sequence number\nPOST /api/fact-checks    factCheckStart          PUBLIC_WRITES + rate limit\nPOST /api/evidence       evidence submission     PUBLIC_WRITES + rate limit\nPOST /api/agents/register  registerZkBackedAgent  zkLogin signature check\nPOST /api/claims         claimCreate             Bearer operator token", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200019, "version": 1, "versionNonce": 200020, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "sf_gate", "x": 60, "y": 960, "width": 620, "height": 178, "strokeColor": "#b45309", "backgroundColor": "#fef3c7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200021, "version": 1, "versionNonce": 200022, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "sf_gate_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "sf_gate_t", "x": 72, "y": 968, "width": 596, "height": 162, "text": "GATES  app/api/_lib/guard.ts  (four trust tiers)\nwatch    nothing: every GET is anonymous, the whole docket is public\nask      OPENVERDICT_PUBLIC_WRITES=enabled; 60 writes/min globally,\n         5/min per IP only when OPENVERDICT_TRUST_PROXY=1\njudge    zkLogin (Google via Enoki) signs a canonical message;\n         blake2b256(zkLogin address) becomes human_backing_hash:\n         one social account backs one seat (never proof of personhood)\noperate  Bearer OPENVERDICT_OPERATOR_TOKEN, >=16 chars, timing-safe", "originalText": "GATES  app/api/_lib/guard.ts  (four trust tiers)\nwatch    nothing: every GET is anonymous, the whole docket is public\nask      OPENVERDICT_PUBLIC_WRITES=enabled; 60 writes/min globally,\n         5/min per IP only when OPENVERDICT_TRUST_PROXY=1\njudge    zkLogin (Google via Enoki) signs a canonical message;\n         blake2b256(zkLogin address) becomes human_backing_hash:\n         one social account backs one seat (never proof of personhood)\noperate  Bearer OPENVERDICT_OPERATOR_TOKEN, >=16 chars, timing-safe", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200023, "version": 1, "versionNonce": 200024, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "sf_gate", "lineHeight": 1.25 },

    { "type": "rectangle", "id": "sf_cli", "x": 60, "y": 1160, "width": 620, "height": 84, "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200025, "version": 1, "versionNonce": 200026, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "sf_cli_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "sf_cli_t", "x": 72, "y": 1168, "width": 596, "height": 68, "text": "openverdict CLI   cli/src/index.ts   complete headless control surface\nfact-check start, claim create / inspect --verify, jury run --phase 1|2,\nvotes commit / reveal, claim advance / finalize, events follow --json\nsame Engine seam as the API; a laptop can run the whole lifecycle", "originalText": "openverdict CLI   cli/src/index.ts   complete headless control surface\nfact-check start, claim create / inspect --verify, jury run --phase 1|2,\nvotes commit / reveal, claim advance / finalize, events follow --json\nsame Engine seam as the API; a laptop can run the whole lifecycle", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200027, "version": 1, "versionNonce": 200028, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "sf_cli", "lineHeight": 1.25 },

    { "type": "text", "id": "sf_nosigner", "x": 60, "y": 1266, "width": 620, "height": 81, "text": "The browser holds NO protocol signer. A wallet or zkLogin session signs only\na registration message (or a demo-pool deposit). Every protocol transaction\n(claim, seats, commits, reveals, certificate) is signed inside the engine by\nSignerRegistry: operator key + 7 agent keys from OPENVERDICT_AGENT_SEED.", "originalText": "The browser holds NO protocol signer. A wallet or zkLogin session signs only\na registration message (or a demo-pool deposit). Every protocol transaction\n(claim, seats, commits, reveals, certificate) is signed inside the engine by\nSignerRegistry: operator key + 7 agent keys from OPENVERDICT_AGENT_SEED.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200029, "version": 1, "versionNonce": 200030, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "sf_jury_title", "x": 60, "y": 1370, "width": 620, "height": 20, "text": "THE JURY POOL TODAY (7 seats, verified against chain 7/7)", "originalText": "THE JURY POOL TODAY (7 seats, verified against chain 7/7)", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#3b82f6", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200031, "version": 1, "versionNonce": 200032, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "sf_jury_text", "x": 60, "y": 1396, "width": 620, "height": 163, "text": "7 AgentCaps registered on Sui testnet under deterministic owner addresses,\nbound into Neon by scripts/seed-testnet-agents.ts, which spends no SUI:\n  3 x deepseek-ai/DeepSeek-V4-Flash-0731   role SOURCE_AUTHENTICITY\n  2 x MiniMaxAI/MiniMax-M2.7               role SKEPTIC\n  2 x moonshotai/Kimi-K2.6                 role SKEPTIC\nselect_committee needs 7 to 32 active records (hence exactly 7), draws by\nEligibilityRecord.weight (default 10000, AdminCap-set), keeps 2 reserves,\nand enforces 3+ model families, max 2 seats per model, both roles present.\nReputation (7 dimensions) exists on chain but nothing ever updates it.", "originalText": "7 AgentCaps registered on Sui testnet under deterministic owner addresses,\nbound into Neon by scripts/seed-testnet-agents.ts, which spends no SUI:\n  3 x deepseek-ai/DeepSeek-V4-Flash-0731   role SOURCE_AUTHENTICITY\n  2 x MiniMaxAI/MiniMax-M2.7               role SKEPTIC\n  2 x moonshotai/Kimi-K2.6                 role SKEPTIC\nselect_committee needs 7 to 32 active records (hence exactly 7), draws by\nEligibilityRecord.weight (default 10000, AdminCap-set), keeps 2 reserves,\nand enforces 3+ model families, max 2 seats per model, both roles present.\nReputation (7 dimensions) exists on chain but nothing ever updates it.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200033, "version": 1, "versionNonce": 200034, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "ta_room", "x": 1680, "y": 330, "width": 840, "height": 1240, "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400001, "version": 1, "versionNonce": 400002, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "ta_room_title", "x": 1700, "y": 342, "width": 800, "height": 25, "text": "LEVEL 2: TRUST ANCHORS (outside the engine's control)", "originalText": "LEVEL 2: TRUST ANCHORS (outside the engine's control)", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400003, "version": 1, "versionNonce": 400004, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "ta_gonka", "x": 1700, "y": 385, "width": 800, "height": 70, "strokeColor": "#6d28d9", "backgroundColor": "#ddd6fe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400005, "version": 1, "versionNonce": 400006, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "ta_gonka_t", "type": "text" }, { "id": "cx_gonka", "type": "arrow" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "ta_gonka_t", "x": 1710, "y": 395, "width": 780, "height": 50, "text": "GonkaRouter  https://api.gonkarouter.io/v1  (decentralized Gonka inference)\nPOST /v1/chat/completions, max_tokens 4096, 120 s timeout, 1 visible retry", "originalText": "GonkaRouter  https://api.gonkarouter.io/v1  (decentralized Gonka inference)\nPOST /v1/chat/completions, max_tokens 4096, 120 s timeout, 1 visible retry", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400007, "version": 1, "versionNonce": 400008, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "ta_gonka", "lineHeight": 1.25 },
    { "type": "text", "id": "ta_gonka_note", "x": 1700, "y": 465, "width": 800, "height": 65, "text": "manifest models: deepseek-ai/DeepSeek-V4-Flash-0731, MiniMaxAI/MiniMax-M2.7, moonshotai/Kimi-K2.6\nthe model receives the claim + the frozen evidence manifest as JSON (OracleInferenceInput),\nnever a URL or a key; every response id (msg_... / devshard-...) is kept verbatim as the\npublic Gonka Request ID and lands in the run audit", "originalText": "manifest models: deepseek-ai/DeepSeek-V4-Flash-0731, MiniMaxAI/MiniMax-M2.7, moonshotai/Kimi-K2.6\nthe model receives the claim + the frozen evidence manifest as JSON (OracleInferenceInput),\nnever a URL or a key; every response id (msg_... / devshard-...) is kept verbatim as the\npublic Gonka Request ID and lands in the run audit", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400009, "version": 1, "versionNonce": 400010, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "rectangle", "id": "ta_schema", "x": 1700, "y": 545, "width": 800, "height": 145, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400011, "version": 1, "versionNonce": 400012, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "ta_schema_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "ta_schema_t", "x": 1716, "y": 555, "width": 768, "height": 125, "text": "// OracleInferenceOutput (lib/gonka/schemas.ts, zod .strict()): anything else is NO_VALID_INFERENCE\n{ \"outcome\": \"YES\" | \"NO\" | \"UNSURE\",   \"confidenceBps\": 0..10000,\n  \"evidenceFor\": [ids], \"evidenceAgainst\": [ids],\n  \"unsupportedClaims\": [ids], \"decisiveEvidence\": [ids],\n  \"reasoning\": <= 4000 UTF-8 bytes,\n  \"publicReasoningTrace\": 1..8 x { \"check\", \"evidenceIds\", \"finding\",\n                                   \"assessment\": SUPPORTS | CONTRADICTS | MIXED | INSUFFICIENT } }\n// validateOutputAgainstManifest: a cited evidenceId absent from the frozen manifest rejects the run", "originalText": "// OracleInferenceOutput (lib/gonka/schemas.ts, zod .strict()): anything else is NO_VALID_INFERENCE\n{ \"outcome\": \"YES\" | \"NO\" | \"UNSURE\",   \"confidenceBps\": 0..10000,\n  \"evidenceFor\": [ids], \"evidenceAgainst\": [ids],\n  \"unsupportedClaims\": [ids], \"decisiveEvidence\": [ids],\n  \"reasoning\": <= 4000 UTF-8 bytes,\n  \"publicReasoningTrace\": 1..8 x { \"check\", \"evidenceIds\", \"finding\",\n                                   \"assessment\": SUPPORTS | CONTRADICTS | MIXED | INSUFFICIENT } }\n// validateOutputAgainstManifest: a cited evidenceId absent from the frozen manifest rejects the run", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400013, "version": 1, "versionNonce": 400014, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "ta_schema", "lineHeight": 1.25 },

    { "type": "rectangle", "id": "ta_sui", "x": 1700, "y": 705, "width": 800, "height": 70, "strokeColor": "#1e3a5f", "backgroundColor": "#3b82f6", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400015, "version": 1, "versionNonce": 400016, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "ta_sui_t", "type": "text" }, { "id": "cx_sui", "type": "arrow" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "ta_sui_t", "x": 1710, "y": 715, "width": 780, "height": 50, "text": "Sui testnet: the coordination and settlement court (nothing settles off it)\npackage 0xb411210a...474c1d   registry 0x9036764a...afe05   Clock 0x6   Random 0x8", "originalText": "Sui testnet: the coordination and settlement court (nothing settles off it)\npackage 0xb411210a...474c1d   registry 0x9036764a...afe05   Clock 0x6   Random 0x8", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400017, "version": 1, "versionNonce": 400018, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "ta_sui", "lineHeight": 1.25 },
    { "type": "text", "id": "ta_sui_note", "x": 1700, "y": 785, "width": 800, "height": 195, "text": "Move package move/openverdict/sources (66/66 sui move tests)\nagent_registry   AgentProfile (shared) + AgentCap (owned): bond, human_backing_hash, timelocked exit\nclaim            Claim (shared): u8 state, mode, deadlines, budgets, evidence + certificate links\nevidence         EvidenceBundle (frozen): Merkle root over the accepted items + Walrus blob ids\njury             select_committee: a private entry fun that draws 5 seats with &Random in one call,\n                 then Committee, RoundTally (shared) and 5 owned JurySeats; commit -> reveal ->\n                 RevealedVote (frozen); the reveal recomputes the commitment on chain\nsettlement       ResolutionCertificate (frozen) + one-time PayoutTicket objects\ndemo_binary_pool / demo_fact_checker / display_meta   the first consumer + Object Display metadata\ncapabilities the operator holds (config/release.testnet.json): AdminCap, PauseCap, EvidenceCap,\nRunAttestorCap. A hackathon-grade trust model: one run attestor, one evidence freezer, documented.", "originalText": "Move package move/openverdict/sources (66/66 sui move tests)\nagent_registry   AgentProfile (shared) + AgentCap (owned): bond, human_backing_hash, timelocked exit\nclaim            Claim (shared): u8 state, mode, deadlines, budgets, evidence + certificate links\nevidence         EvidenceBundle (frozen): Merkle root over the accepted items + Walrus blob ids\njury             select_committee: a private entry fun that draws 5 seats with &Random in one call,\n                 then Committee, RoundTally (shared) and 5 owned JurySeats; commit -> reveal ->\n                 RevealedVote (frozen); the reveal recomputes the commitment on chain\nsettlement       ResolutionCertificate (frozen) + one-time PayoutTicket objects\ndemo_binary_pool / demo_fact_checker / display_meta   the first consumer + Object Display metadata\ncapabilities the operator holds (config/release.testnet.json): AdminCap, PauseCap, EvidenceCap,\nRunAttestorCap. A hackathon-grade trust model: one run attestor, one evidence freezer, documented.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400019, "version": 1, "versionNonce": 400020, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "rectangle", "id": "ta_commit", "x": 1700, "y": 995, "width": 800, "height": 90, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400021, "version": 1, "versionNonce": 400022, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "ta_commit_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "ta_commit_t", "x": 1716, "y": 1005, "width": 768, "height": 70, "text": "// stored at commit, recomputed on chain at reveal (lib/protocol/commitment.ts == jury::compute_commitment)\ncommitment = blake2b256(BCS(VotePreimageV1 { claim_id, agent_profile_id, jury_seat_id, phase, outcome,\n                confidence_bps, evidence_root, output_hash, run_hash, salt }))\n// salt: 32 random bytes, Postgres only; reveal must reproduce them; 6 parity vectors pin TS == Move", "originalText": "// stored at commit, recomputed on chain at reveal (lib/protocol/commitment.ts == jury::compute_commitment)\ncommitment = blake2b256(BCS(VotePreimageV1 { claim_id, agent_profile_id, jury_seat_id, phase, outcome,\n                confidence_bps, evidence_root, output_hash, run_hash, salt }))\n// salt: 32 random bytes, Postgres only; reveal must reproduce them; 6 parity vectors pin TS == Move", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400023, "version": 1, "versionNonce": 400024, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "ta_commit", "lineHeight": 1.25 },

    { "type": "rectangle", "id": "ta_walrus", "x": 1700, "y": 1110, "width": 800, "height": 70, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400025, "version": 1, "versionNonce": 400026, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "ta_walrus_t", "type": "text" }, { "id": "cx_walrus", "type": "arrow" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "ta_walrus_t", "x": 1710, "y": 1120, "width": 780, "height": 50, "text": "Walrus testnet: public, content-addressed artifact storage\n@mysten/walrus writeFiles, 10 epochs by default, every blob referenced by blobId from Sui", "originalText": "Walrus testnet: public, content-addressed artifact storage\n@mysten/walrus writeFiles, 10 epochs by default, every blob referenced by blobId from Sui", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400027, "version": 1, "versionNonce": 400028, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "ta_walrus", "lineHeight": 1.25 },
    { "type": "text", "id": "ta_walrus_note", "x": 1700, "y": 1190, "width": 800, "height": 50, "text": "raw + canonicalised evidence bytes (one blob per fetched source), the evidence manifest, and each\njuror's argument + run audit (output, hashes, Gonka Request ID) once revealed. Anyone can refetch\na blob, hash it, and compare with the root frozen in the EvidenceBundle.", "originalText": "raw + canonicalised evidence bytes (one blob per fetched source), the evidence manifest, and each\njuror's argument + run audit (output, hashes, Gonka Request ID) once revealed. Anyone can refetch\na blob, hash it, and compare with the root frozen in the EvidenceBundle.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400029, "version": 1, "versionNonce": 400030, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "ta_score", "x": 1700, "y": 1260, "width": 800, "height": 90, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400031, "version": 1, "versionNonce": 400032, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "ta_score_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "ta_score_t", "x": 1716, "y": 1270, "width": 768, "height": 70, "text": "// Truth Score (lib/protocol/truthScore.ts): anyone can recompute it from the frozen RevealedVotes\nper vote:  YES -> confidenceBps    NO -> 10000 - confidenceBps    UNSURE -> 5000\nscore_bps = (sum + floor(n / 2)) / n          // half-up integer mean, unweighted, final valid round only\ndemo 2026-08-27: 5 reveals, YES @ 9700 bps; off-chain recompute == certificate 0x8efdabe0...1a8634", "originalText": "// Truth Score (lib/protocol/truthScore.ts): anyone can recompute it from the frozen RevealedVotes\nper vote:  YES -> confidenceBps    NO -> 10000 - confidenceBps    UNSURE -> 5000\nscore_bps = (sum + floor(n / 2)) / n          // half-up integer mean, unweighted, final valid round only\ndemo 2026-08-27: 5 reveals, YES @ 9700 bps; off-chain recompute == certificate 0x8efdabe0...1a8634", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400033, "version": 1, "versionNonce": 400034, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "ta_score", "lineHeight": 1.25 },

    { "type": "text", "id": "ta_ladder", "x": 1700, "y": 1370, "width": 800, "height": 65, "text": "testnet deadline ladder (defaultDeadlines in engine.ts): evidence +5 min, proposal +10, challenge +15,\ncommit_1 +30, reveal_1 +45, discussion +60, commit_2 +75, reveal_2 +90. Commit and reveal deadlines are\nFLOORS on chain: advance_phase needs now > commit deadline, finalize needs now > reveal deadline, so a\ndefault-ladder claim needs 45 min (90 with round two); only the CLI / scripts pass shorter deadlines.", "originalText": "testnet deadline ladder (defaultDeadlines in engine.ts): evidence +5 min, proposal +10, challenge +15,\ncommit_1 +30, reveal_1 +45, discussion +60, commit_2 +75, reveal_2 +90. Commit and reveal deadlines are\nFLOORS on chain: advance_phase needs now > commit deadline, finalize needs now > reveal deadline, so a\ndefault-ladder claim needs 45 min (90 with round two); only the CLI / scripts pass shorter deadlines.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400035, "version": 1, "versionNonce": 400036, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "ta_settle", "x": 1700, "y": 1452, "width": 800, "height": 100, "text": "4 of 5 matching valid votes (denominator = committee size, not responders) finalize YES or NO;\n4 of 5 UNSURE finalizes UNRESOLVED; a split opens one DISCUSSION round (arguments published, new\nevidence window, fresh seats, second commit + reveal); no threshold after that finalizes UNRESOLVED\nrather than a manufactured answer. A direct-review claim then pays jury rewards and refunds the\nunused budget; an economic claim mints PayoutTickets the demo pool redeems against the certificate.", "originalText": "4 of 5 matching valid votes (denominator = committee size, not responders) finalize YES or NO;\n4 of 5 UNSURE finalizes UNRESOLVED; a split opens one DISCUSSION round (arguments published, new\nevidence window, fresh seats, second commit + reveal); no threshold after that finalizes UNRESOLVED\nrather than a manufactured answer. A direct-review claim then pays jury rewards and refunds the\nunused budget; an economic claim mints PayoutTickets the demo pool redeems against the certificate.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400037, "version": 1, "versionNonce": 400038, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "dp_title", "x": 40, "y": 1620, "width": 1400, "height": 25, "text": "LEVEL 3: WHERE EACH ARTIFACT LIVES (the answer to \"why not put everything on Sui\")", "originalText": "LEVEL 3: WHERE EACH ARTIFACT LIVES (the answer to \"why not put everything on Sui\")", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 600001, "version": 1, "versionNonce": 600002, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "dp_sui", "x": 40, "y": 1660, "width": 800, "height": 250, "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 600003, "version": 1, "versionNonce": 600004, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "rectangle", "id": "dp_sui_tab", "x": 40, "y": 1660, "width": 800, "height": 34, "strokeColor": "#1e3a5f", "backgroundColor": "#3b82f6", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 600005, "version": 1, "versionNonce": 600006, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "dp_sui_tab_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "dp_sui_tab_t", "x": 50, "y": 1665, "width": 780, "height": 24, "text": "ON SUI: public, enforced by Move, the only authority", "originalText": "ON SUI: public, enforced by Move, the only authority", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 600007, "version": 1, "versionNonce": 600008, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "dp_sui_tab", "lineHeight": 1.25 },
    { "type": "text", "id": "dp_sui_body", "x": 56, "y": 1704, "width": 770, "height": 195, "text": "Claim               statement hash, mode, u8 state, deadlines, budgets, links to bundle + certificate\nAgentProfile + Cap  manifest_hash, model_hash, role_hash, human_backing_hash, bond, reputation struct\nCommittee + Seats   the draw, its seed, 5 owned JurySeats (one per selected profile)\nvote commitment     bytes32 on each JurySeat: the chain sees a hash, never an outcome\nRevealedVote        frozen: outcome, confidence_bps, output_hash, run_hash, argument blob id\nRoundTally          the bounded count every finalizer must use (4 of 5)\nEvidenceBundle      frozen: Merkle root over the accepted items + manifest blob id\nResolutionCert.     frozen: result, truth_score_bps, committee + evidence references\nPayoutTicket        one-time settlement claims consumed by demo_binary_pool\nevents              ClaimCreated and friends: the discovery signal an indexer or the observer follows", "originalText": "Claim               statement hash, mode, u8 state, deadlines, budgets, links to bundle + certificate\nAgentProfile + Cap  manifest_hash, model_hash, role_hash, human_backing_hash, bond, reputation struct\nCommittee + Seats   the draw, its seed, 5 owned JurySeats (one per selected profile)\nvote commitment     bytes32 on each JurySeat: the chain sees a hash, never an outcome\nRevealedVote        frozen: outcome, confidence_bps, output_hash, run_hash, argument blob id\nRoundTally          the bounded count every finalizer must use (4 of 5)\nEvidenceBundle      frozen: Merkle root over the accepted items + manifest blob id\nResolutionCert.     frozen: result, truth_score_bps, committee + evidence references\nPayoutTicket        one-time settlement claims consumed by demo_binary_pool\nevents              ClaimCreated and friends: the discovery signal an indexer or the observer follows", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 600009, "version": 1, "versionNonce": 600010, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "dp_walrus", "x": 860, "y": 1660, "width": 800, "height": 250, "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 600011, "version": 1, "versionNonce": 600012, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "rectangle", "id": "dp_walrus_tab", "x": 860, "y": 1660, "width": 800, "height": 34, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 600013, "version": 1, "versionNonce": 600014, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "dp_walrus_tab_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "dp_walrus_tab_t", "x": 870, "y": 1665, "width": 780, "height": 24, "text": "ON WALRUS: public, content-addressed, refetchable by anyone", "originalText": "ON WALRUS: public, content-addressed, refetchable by anyone", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 600015, "version": 1, "versionNonce": 600016, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "dp_walrus_tab", "lineHeight": 1.25 },
    { "type": "text", "id": "dp_walrus_body", "x": 876, "y": 1704, "width": 770, "height": 195, "text": "evidence bytes       one blob per fetched source: the raw response AND the canonicalised text\nevidence manifest    the items (evidenceId, sourceClass, retrievedAt, walrusBlobId, contentHash, excerpt)\n                     whose hashes form the Merkle root frozen on Sui\nclaim text           statement + resolution criteria blobs; the Claim holds only hash + blob id\nrun bundle           rawResponse + validatedOutput + audit + runHash, uploaded DURING juryRun (before\n                     the commit) and referenced by the on-chain RunApproval; the reveal cites it as\n                     argument_blob_id. Design gap: a vote is readable here before its reveal\nagent manifest       manifestBlobId on the AgentProfile: prompt hash, tool policy, evidence policy\n\nlink from Sui: every blob id sits in a frozen object, so a swapped blob fails its hash check", "originalText": "evidence bytes       one blob per fetched source: the raw response AND the canonicalised text\nevidence manifest    the items (evidenceId, sourceClass, retrievedAt, walrusBlobId, contentHash, excerpt)\n                     whose hashes form the Merkle root frozen on Sui\nclaim text           statement + resolution criteria blobs; the Claim holds only hash + blob id\nrun bundle           rawResponse + validatedOutput + audit + runHash, uploaded DURING juryRun (before\n                     the commit) and referenced by the on-chain RunApproval; the reveal cites it as\n                     argument_blob_id. Design gap: a vote is readable here before its reveal\nagent manifest       manifestBlobId on the AgentProfile: prompt hash, tool policy, evidence policy\n\nlink from Sui: every blob id sits in a frozen object, so a swapped blob fails its hash check", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 600017, "version": 1, "versionNonce": 600018, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "dp_db", "x": 1680, "y": 1660, "width": 840, "height": 250, "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 600019, "version": 1, "versionNonce": 600020, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "rectangle", "id": "dp_db_tab", "x": 1680, "y": 1660, "width": 840, "height": 34, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 600021, "version": 1, "versionNonce": 600022, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "dp_db_tab_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "dp_db_tab_t", "x": 1690, "y": 1665, "width": 820, "height": 24, "text": "IN POSTGRES (Neon): the engine's private working memory, never the authority", "originalText": "IN POSTGRES (Neon): the engine's private working memory, never the authority", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 600023, "version": 1, "versionNonce": 600024, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "dp_db_tab", "lineHeight": 1.25 },
    { "type": "text", "id": "dp_db_body", "x": 1696, "y": 1704, "width": 810, "height": 195, "text": "vote_packages.salt_hex   the 32-byte salts behind every commitment. THIS is why a database exists:\n                         published before the reveal, jurors could read each other's votes and\n                         independence collapses; after the reveal the salt is public anyway\nresolution_events        append-only, phase-gated log; the SSE stream and the observer read it\nclaims / committees /    a fast mirror of chain state plus what chain does not hold: submitted\nrun audits               text, URLs, per-attempt model responses, retries, redactions\nagent manifests          the 7 seeded jurors bound to their on-chain AgentProfile ids\n16 tables in lib/storage/schema.ts. engine.ts:615 TODO: salts are plaintext hex, encrypt before production.\nif Postgres is lost before a reveal, that round cannot reveal and the claim ends UNRESOLVED;\nafter the certificate exists, nothing in Postgres is needed to verify it", "originalText": "vote_packages.salt_hex   the 32-byte salts behind every commitment. THIS is why a database exists:\n                         published before the reveal, jurors could read each other's votes and\n                         independence collapses; after the reveal the salt is public anyway\nresolution_events        append-only, phase-gated log; the SSE stream and the observer read it\nclaims / committees /    a fast mirror of chain state plus what chain does not hold: submitted\nrun audits               text, URLs, per-attempt model responses, retries, redactions\nagent manifests          the 7 seeded jurors bound to their on-chain AgentProfile ids\n16 tables in lib/storage/schema.ts. engine.ts:615 TODO: salts are plaintext hex, encrypt before production.\nif Postgres is lost before a reveal, that round cannot reveal and the claim ends UNRESOLVED;\nafter the certificate exists, nothing in Postgres is needed to verify it", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 600025, "version": 1, "versionNonce": 600026, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "pr_title", "x": 40, "y": 1960, "width": 1400, "height": 25, "text": "PRODUCTION TODAY vs WHAT THE DESIGN EXPECTS", "originalText": "PRODUCTION TODAY vs WHAT THE DESIGN EXPECTS", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 700001, "version": 1, "versionNonce": 700002, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "pr_browser", "x": 40, "y": 2010, "width": 200, "height": 60, "strokeColor": "#c2410c", "backgroundColor": "#fed7aa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 700003, "version": 1, "versionNonce": 700004, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "pr_browser_t", "type": "text" }, { "id": "pr_a1", "type": "arrow" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "pr_browser_t", "x": 50, "y": 2020, "width": 180, "height": 40, "text": "browser\nopenverdict.info", "originalText": "browser\nopenverdict.info", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 700005, "version": 1, "versionNonce": 700006, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "pr_browser", "lineHeight": 1.25 },
    { "type": "arrow", "id": "pr_a1", "x": 242, "y": 2040, "width": 56, "height": 0, "strokeColor": "#c2410c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 700007, "version": 1, "versionNonce": 700008, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "points": [[0, 0], [56, 0]], "startBinding": { "elementId": "pr_browser", "focus": 0, "gap": 2 }, "endBinding": { "elementId": "pr_vercel", "focus": 0, "gap": 2 }, "startArrowhead": null, "endArrowhead": "arrow" },
    { "type": "rectangle", "id": "pr_vercel", "x": 300, "y": 2000, "width": 420, "height": 80, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 700009, "version": 1, "versionNonce": 700010, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "pr_vercel_t", "type": "text" }, { "id": "pr_a1", "type": "arrow" }, { "id": "pr_a2", "type": "arrow" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "pr_vercel_t", "x": 310, "y": 2010, "width": 400, "height": 60, "text": "Vercel project open-verdict\nNext.js pages + /api/* as serverless functions\nrequest side of the engine only", "originalText": "Vercel project open-verdict\nNext.js pages + /api/* as serverless functions\nrequest side of the engine only", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 700011, "version": 1, "versionNonce": 700012, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "pr_vercel", "lineHeight": 1.25 },
