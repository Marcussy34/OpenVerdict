   "locked": false,
   "fontSize": 12,
   "fontFamily": 3,
   "text": "GONKAROUTER  (AI inference gateway)\n\nPOST /v1/chat/completions - x-api-key\nrequest id + devshard id kept per call;\npublic receipts cross-checked after reveal\nthree model families, at most two seats per model\n(two families, three seats in degraded mode),\nX-Gonka-No-Fallback\nGonka Hosts execute - Gonka L1 records",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "GONKAROUTER  (AI inference gateway)\n\nPOST /v1/chat/completions - x-api-key\nrequest id + devshard id kept per call;\npublic receipts cross-checked after reveal\nthree model families, at most two seats per model\n(two families, three seats in degraded mode),\nX-Gonka-No-Fallback\nGonka Hosts execute - Gonka L1 records",
   "lineHeight": 1.25,
   "baseline": 12
  },
