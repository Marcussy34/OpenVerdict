  {
   "id": "engine_note",
   "type": "text",
   "x": 430,
   "y": 802,
   "width": 412,
   "height": 180,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 200012,
   "version": 1,
   "versionNonce": 200112,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 12,
   "fontFamily": 3,
   "text": "fail closed:\n- malformed model output never becomes a vote\n- models get zero URLs, keys, or tx authority\n- salts never leave the engine\n- every AI step has a Gonka Request ID\n- a failed seat voids the whole attempt; relaunch on\n  clear weather, up to three\n- submissions are refused until every active model family\n  and web search answer a probe (503, nothing stored)\n- degraded mode: the operator may lower the draw to two\n  families on chain (JuryDiversityChanged event); every\n  certificate and report says so",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "fail closed:\n- malformed model output never becomes a vote\n- models get zero URLs, keys, or tx authority\n- salts never leave the engine\n- every AI step has a Gonka Request ID\n- a failed seat voids the whole attempt; relaunch on\n  clear weather, up to three\n- submissions are refused until every active model family\n  and web search answer a probe (503, nothing stored)\n- degraded mode: the operator may lower the draw to two\n  families on chain (JuryDiversityChanged event); every\n  certificate and report says so",
   "lineHeight": 1.25,
   "baseline": 12
  },
