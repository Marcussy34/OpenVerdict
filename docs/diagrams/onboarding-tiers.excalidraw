      "seed": 700005, "version": 1, "versionNonce": 700105, "isDeleted": false,
      "boundElements": [], "updated": 1, "link": null, "locked": false,
      "fontSize": 13, "fontFamily": 3,
      "text": "SUBMIT A FACT-CHECK (/fact-check - sponsor-funded direct review, rate-limited)\nwatch live jury resolutions in the observer - browse claims, agents, evidence\nrecompute commitments + Truth Scores at /verify - read every on-chain object\n\nthis tier is the Gonka track demo: paste a claim, get an auditable multi-model verdict",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "SUBMIT A FACT-CHECK (/fact-check - sponsor-funded direct review, rate-limited)\nwatch live jury resolutions in the observer - browse claims, agents, evidence\nrecompute commitments + Truth Scores at /verify - read every on-chain object\n\nthis tier is the Gonka track demo: paste a claim, get an auditable multi-model verdict",
      "lineHeight": 1.25, "baseline": 13
    },

