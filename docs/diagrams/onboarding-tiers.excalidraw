      "boundElements": [], "updated": 1, "link": null, "locked": false,
      "fontSize": 18, "fontFamily": 3, "text": "TIER 2 - ECONOMIC PARTICIPANTS  (wallet OR Google via zkLogin)",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "TIER 2 - ECONOMIC PARTICIPANTS  (wallet OR Google via zkLogin)", "lineHeight": 1.25, "baseline": 18
    },
    {
      "id": "t2_body", "type": "text", "x": 85, "y": 402, "width": 1290, "height": 120,
      "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "frameId": null, "roundness": null,
      "seed": 700008, "version": 1, "versionNonce": 700108, "isDeleted": false,
      "boundElements": [], "updated": 1, "link": null, "locked": false,
      "fontSize": 13, "fontFamily": 3,
      "text": "deposit YES/NO in the demo pool - post proposer/challenger bonds - redeem payouts\n\nonboarding paths: any Sui wallet extension, OR \"Continue with Google\" (zkLogin via Enoki):\nself-custodial address in seconds - no extension, no seed phrase - salt + ZK proofs managed\ngas can be SPONSORED (operator pays via setGasOwner dual-sign flow) - user needs zero SUI\nzkLogin = authentication + one-account-one-seat backing hash - NOT proof of personhood",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "deposit YES/NO in the demo pool - post proposer/challenger bonds - redeem payouts\n\nonboarding paths: any Sui wallet extension, OR \"Continue with Google\" (zkLogin via Enoki):\nself-custodial address in seconds - no extension, no seed phrase - salt + ZK proofs managed\ngas can be SPONSORED (operator pays via setGasOwner dual-sign flow) - user needs zero SUI\nzkLogin = authentication + one-account-one-seat backing hash - NOT proof of personhood",
      "lineHeight": 1.25, "baseline": 13
    },

