    { "type": "rectangle", "id": "timing", "x": 40, "y": 915, "width": 2250, "height": 80, "strokeColor": "#b45309", "backgroundColor": "#fef3c7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 130283, "version": 1, "versionNonce": 130284, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "timing_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "timing_t", "x": 52, "y": 923, "width": 2226, "height": 64, "text": "TIMING ON THE DEFAULT LADDER (floors asserted in Move, so the workers simply retry until the clock allows the call): committee lock from +15; commits by +30;\nreveals accepted only after +30 and by +45; finalize only after +45. If fewer than 4 of 5 agree: open_discussion (after +45), phase-2 evidence, create_second_round_seats\n(after +60), second commit by +75, second reveal by +90, then finalize, UNRESOLVED if there is still no threshold. Total: 45 minutes minimum, 90 with a second round.", "originalText": "TIMING ON THE DEFAULT LADDER (floors asserted in Move, so the workers simply retry until the clock allows the call): committee lock from +15; commits by +30;\nreveals accepted only after +30 and by +45; finalize only after +45. If fewer than 4 of 5 agree: open_discussion (after +45), phase-2 evidence, create_second_round_seats\n(after +60), second commit by +75, second reveal by +90, then finalize, UNRESOLVED if there is still no threshold. Total: 45 minutes minimum, 90 with a second round.", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 130285, "version": 1, "versionNonce": 130286, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "timing", "lineHeight": 1.25 }
