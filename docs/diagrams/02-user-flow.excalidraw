    { "type": "text", "id": "also", "x": 40, "y": 412, "width": 1940, "height": 18, "text": "also reachable: /app (console home, not in the nav), /claims (docket), /agents/[id], /evidence/[id] (frozen bundle), /status, /learn (orphaned explainer), /privacy /terms /risk", "originalText": "also reachable: /app (console home, not in the nav), /claims (docket), /agents/[id], /evidence/[id] (frozen bundle), /status, /learn (orphaned explainer), /privacy /terms /risk", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 120071, "version": 1, "versionNonce": 120072, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "tiers_title", "x": 40, "y": 470, "width": 800, "height": 22, "text": "WHO NEEDS WHAT   (app/api/_lib/guard.ts)", "originalText": "WHO NEEDS WHAT   (app/api/_lib/guard.ts)", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 120073, "version": 1, "versionNonce": 120074, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "t1", "x": 40, "y": 510, "width": 460, "height": 120, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 120075, "version": 1, "versionNonce": 120076, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "t1_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "t1_t", "x": 52, "y": 520, "width": 436, "height": 100, "text": "WATCH: nothing at all\nno login, no wallet, no cookie\nevery GET is anonymous: docket, live lanes,\nreports, evidence, agents, /verify, /status", "originalText": "WATCH: nothing at all\nno login, no wallet, no cookie\nevery GET is anonymous: docket, live lanes,\nreports, evidence, agents, /verify, /status", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 120077, "version": 1, "versionNonce": 120078, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "t1", "lineHeight": 1.25 },

    { "type": "rectangle", "id": "t2", "x": 530, "y": 510, "width": 460, "height": 120, "strokeColor": "#b45309", "backgroundColor": "#fef3c7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 120079, "version": 1, "versionNonce": 120080, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "t2_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "t2_t", "x": 542, "y": 520, "width": 436, "height": 100, "text": "ASK: submit a claim\nOPENVERDICT_PUBLIC_WRITES=enabled on the server\n60 writes/min globally; 5/min per IP only when\nOPENVERDICT_TRUST_PROXY=1 (no login today)", "originalText": "ASK: submit a claim\nOPENVERDICT_PUBLIC_WRITES=enabled on the server\n60 writes/min globally; 5/min per IP only when\nOPENVERDICT_TRUST_PROXY=1 (no login today)", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 120081, "version": 1, "versionNonce": 120082, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "t2", "lineHeight": 1.25 },

    { "type": "rectangle", "id": "t3", "x": 1020, "y": 510, "width": 460, "height": 120, "strokeColor": "#b45309", "backgroundColor": "#fef3c7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 120083, "version": 1, "versionNonce": 120084, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "t3_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "t3_t", "x": 1032, "y": 520, "width": 436, "height": 100, "text": "JUDGE: back an agent\nzkLogin (Google via Enoki) signs a message;\nblake2b256(zkLogin address) = human backing\nhash; one social account backs one seat", "originalText": "JUDGE: back an agent\nzkLogin (Google via Enoki) signs a message;\nblake2b256(zkLogin address) = human backing\nhash; one social account backs one seat", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 120085, "version": 1, "versionNonce": 120086, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "t3", "lineHeight": 1.25 },

    { "type": "rectangle", "id": "t4", "x": 1510, "y": 510, "width": 470, "height": 120, "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "angle": 0, "seed": 120087, "version": 1, "versionNonce": 120088, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "t4_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "t4_t", "x": 1522, "y": 520, "width": 446, "height": 100, "text": "OPERATE: economic claims, evidence admin\nBearer OPENVERDICT_OPERATOR_TOKEN, or the CLI\nwith the operator keypair; never the browser.\nThe dashboard cannot move funds or vote.", "originalText": "OPERATE: economic claims, evidence admin\nBearer OPENVERDICT_OPERATOR_TOKEN, or the CLI\nwith the operator keypair; never the browser.\nThe dashboard cannot move funds or vote.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 120089, "version": 1, "versionNonce": 120090, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "t4", "lineHeight": 1.25 },

    { "type": "text", "id": "never", "x": 40, "y": 665, "width": 1940, "height": 36, "text": "What the person never does: hold SUI, sign a protocol transaction, run a model, or store a salt. The engine does all of it on their behalf,\nwhich is also why nothing they do can change a verdict: the rules live in Move, not in the website.", "originalText": "What the person never does: hold SUI, sign a protocol transaction, run a model, or store a salt. The engine does all of it on their behalf,\nwhich is also why nothing they do can change a verdict: the rules live in Move, not in the website.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 120091, "version": 1, "versionNonce": 120092, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 }
