    { "type": "text", "id": "c2b", "x": 382, "y": 196, "width": 266, "height": 160, "text": "statement (5..1000 chars)\noptional text (<= 20k chars)\nup to 5 https:// URLs\noptional resolution criteria\n\nPOST /api/fact-checks\ngate: PUBLIC_WRITES + 60/min\nreturns { claimId } in seconds\nthen router.push to observe", "originalText": "statement (5..1000 chars)\noptional text (<= 20k chars)\nup to 5 https:// URLs\noptional resolution criteria\n\nPOST /api/fact-checks\ngate: PUBLIC_WRITES + 60/min\nreturns { claimId } in seconds\nthen router.push to observe", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 120027, "version": 1, "versionNonce": 120028, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

