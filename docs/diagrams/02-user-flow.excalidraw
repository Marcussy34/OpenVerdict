    { "type": "text", "id": "c3b", "x": 712, "y": 196, "width": 266, "height": 160, "text": "live agent lanes over SSE:\nevidence frozen, 5 seats drawn,\n5 inferences, sealed commits,\nreveals, tally\n\nphase rail shows the deadlines\nwait: >= 45 min on the default\nladder (commit +30, reveal +45)\nresumes after a refresh", "originalText": "live agent lanes over SSE:\nevidence frozen, 5 seats drawn,\n5 inferences, sealed commits,\nreveals, tally\n\nphase rail shows the deadlines\nwait: >= 45 min on the default\nladder (commit +30, reveal +45)\nresumes after a refresh", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 120037, "version": 1, "versionNonce": 120038, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

