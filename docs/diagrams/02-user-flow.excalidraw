    { "type": "text", "id": "title", "x": 40, "y": 30, "width": 900, "height": 35, "text": "OpenVerdict: what a person experiences", "originalText": "OpenVerdict: what a person experiences", "fontSize": 28, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 120001, "version": 1, "versionNonce": 120002, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "subtitle", "x": 40, "y": 74, "width": 1200, "height": 18, "text": "Watching is anonymous. Submitting needs no wallet. Only backing a juror needs Google (zkLogin). Nav: Fact-check, Claims, Agents, Verify, Status.", "originalText": "Watching is anonymous. Submitting needs no wallet. Only backing a juror needs Google (zkLogin). Nav: Fact-check, Claims, Agents, Verify, Status.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 120003, "version": 1, "versionNonce": 120004, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

