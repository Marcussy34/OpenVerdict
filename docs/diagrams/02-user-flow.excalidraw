    { "type": "text", "id": "c1b", "x": 52, "y": 196, "width": 266, "height": 160, "text": "globe hero, live stat card,\nprotocol stack, FAQ, footer\n\nthe promise: paste a claim,\nget a multi-model verdict\nwith every hash exposed\n\nCTA -> /fact-check", "originalText": "globe hero, live stat card,\nprotocol stack, FAQ, footer\n\nthe promise: paste a claim,\nget a multi-model verdict\nwith every hash exposed\n\nCTA -> /fact-check", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 120017, "version": 1, "versionNonce": 120018, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

