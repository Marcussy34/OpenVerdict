    { "type": "text", "id": "c4b", "x": 1042, "y": 196, "width": 266, "height": 160, "text": "verdict: YES / NO / UNSURE /\nUNRESOLVED\nTruth Score 0..100\n5 Gonka Request IDs, each\njuror's argument and hashes\nevidence bundle + certificate id\n\nsettled = frozen on Sui; the\nreport is a projection of it", "originalText": "verdict: YES / NO / UNSURE /\nUNRESOLVED\nTruth Score 0..100\n5 Gonka Request IDs, each\njuror's argument and hashes\nevidence bundle + certificate id\n\nsettled = frozen on Sui; the\nreport is a projection of it", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 120047, "version": 1, "versionNonce": 120048, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

