  "elements": [
    { "type": "text", "id": "title", "x": 40, "y": 30, "width": 900, "height": 35, "text": "OpenVerdict: where each artifact lives", "originalText": "OpenVerdict: where each artifact lives", "fontSize": 28, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 150001, "version": 1, "versionNonce": 150002, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "subtitle", "x": 40, "y": 74, "width": 1400, "height": 18, "text": "the answer to \"why not put everything on Sui\": the salts. Sui decides, Walrus publishes, Postgres remembers.", "originalText": "the answer to \"why not put everything on Sui\": the salts. Sui decides, Walrus publishes, Postgres remembers.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 150003, "version": 1, "versionNonce": 150004, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "sui", "x": 40, "y": 130, "width": 640, "height": 290, "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 150005, "version": 1, "versionNonce": 150006, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "rectangle", "id": "sui_tab", "x": 40, "y": 130, "width": 640, "height": 36, "strokeColor": "#1e3a5f", "backgroundColor": "#3b82f6", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 150007, "version": 1, "versionNonce": 150008, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "sui_tab_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "sui_tab_t", "x": 50, "y": 136, "width": 620, "height": 24, "text": "ON SUI: public, enforced by Move, the only authority", "originalText": "ON SUI: public, enforced by Move, the only authority", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 150009, "version": 1, "versionNonce": 150010, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "sui_tab", "lineHeight": 1.25 },
    { "type": "text", "id": "sui_body", "x": 54, "y": 178, "width": 612, "height": 280, "text": "Claim              statement hash, mode, u8 state, deadlines, budgets,\n                   links to the evidence bundle and the certificate\nAgentProfile+Cap   manifest_hash, model_hash, role_hash, human_backing_hash,\n                   bond, reputation struct (never updated)\nCommittee+Seats    the draw, its seed, 5 owned JurySeats, 2 reserves\nvote commitment    bytes32 on each JurySeat: a hash, never an outcome\nRevealedVote       frozen: outcome, confidence_bps, output_hash, run_hash,\n                   argument blob id\nRoundTally         the bounded count every finalizer must use (4 of 5)\nEvidenceBundle     frozen: Merkle root over accepted items + manifest blob id\nResolutionCert.    frozen: result, truth_score_bps, committee + evidence ids\nPayoutTicket       one-time settlement claims consumed by demo_binary_pool\nevents             ClaimCreated, CommitteeSelected, VoteCommitted, VoteRevealed,\n                   ClaimFinalized: the discovery signal an observer follows", "originalText": "Claim              statement hash, mode, u8 state, deadlines, budgets,\n                   links to the evidence bundle and the certificate\nAgentProfile+Cap   manifest_hash, model_hash, role_hash, human_backing_hash,\n                   bond, reputation struct (never updated)\nCommittee+Seats    the draw, its seed, 5 owned JurySeats, 2 reserves\nvote commitment    bytes32 on each JurySeat: a hash, never an outcome\nRevealedVote       frozen: outcome, confidence_bps, output_hash, run_hash,\n                   argument blob id\nRoundTally         the bounded count every finalizer must use (4 of 5)\nEvidenceBundle     frozen: Merkle root over accepted items + manifest blob id\nResolutionCert.    frozen: result, truth_score_bps, committee + evidence ids\nPayoutTicket       one-time settlement claims consumed by demo_binary_pool\nevents             ClaimCreated, CommitteeSelected, VoteCommitted, VoteRevealed,\n                   ClaimFinalized: the discovery signal an observer follows", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 150011, "version": 1, "versionNonce": 150012, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "walrus", "x": 700, "y": 130, "width": 640, "height": 290, "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 150013, "version": 1, "versionNonce": 150014, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "rectangle", "id": "walrus_tab", "x": 700, "y": 130, "width": 640, "height": 36, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 150015, "version": 1, "versionNonce": 150016, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "walrus_tab_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "walrus_tab_t", "x": 710, "y": 136, "width": 620, "height": 24, "text": "ON WALRUS: public, content-addressed, refetchable by anyone", "originalText": "ON WALRUS: public, content-addressed, refetchable by anyone", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 150017, "version": 1, "versionNonce": 150018, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "walrus_tab", "lineHeight": 1.25 },
    { "type": "text", "id": "walrus_body", "x": 714, "y": 178, "width": 612, "height": 280, "text": "evidence bytes     one blob per fetched source: raw response AND canonical text\nevidence manifest  the items (evidenceId, sourceClass, retrievedAt, walrusBlobId,\n                   contentHash, excerpt) whose hashes form the Merkle root\nclaim text         statement + resolution criteria; the Claim holds hash + id\nrun bundle         SEALED before the commit: AES-256-GCM ciphertext of the canonical\n                   core (prompt spec, exact request, raw response, output, audit,\n                   run hash), cited by the on-chain RunApproval; at reveal the\n                   plaintext bundle + key is published and cited as argument_blob_id\nagent manifest     manifestBlobId on the AgentProfile: the full prompt spec, tool\n                   policy, evidence policy, and their hashes (v2 document)\n\nlink from Sui: every blob id sits in a frozen object; a swapped blob fails its\nhash check, and anyone can refetch a blob and recompute the root", "originalText": "evidence bytes     one blob per fetched source: raw response AND canonical text\nevidence manifest  the items (evidenceId, sourceClass, retrievedAt, walrusBlobId,\n                   contentHash, excerpt) whose hashes form the Merkle root\nclaim text         statement + resolution criteria; the Claim holds hash + id\nrun bundle         SEALED before the commit: AES-256-GCM ciphertext of the canonical\n                   core (prompt spec, exact request, raw response, output, audit,\n                   run hash), cited by the on-chain RunApproval; at reveal the\n                   plaintext bundle + key is published and cited as argument_blob_id\nagent manifest     manifestBlobId on the AgentProfile: the full prompt spec, tool\n                   policy, evidence policy, and their hashes (v2 document)\n\nlink from Sui: every blob id sits in a frozen object; a swapped blob fails its\nhash check, and anyone can refetch a blob and recompute the root", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 150019, "version": 1, "versionNonce": 150020, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "db", "x": 1360, "y": 130, "width": 640, "height": 290, "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 150021, "version": 1, "versionNonce": 150022, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "rectangle", "id": "db_tab", "x": 1360, "y": 130, "width": 640, "height": 36, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 150023, "version": 1, "versionNonce": 150024, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "db_tab_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "db_tab_t", "x": 1370, "y": 136, "width": 620, "height": 24, "text": "IN POSTGRES (Neon): private working memory, never the authority", "originalText": "IN POSTGRES (Neon): private working memory, never the authority", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 150025, "version": 1, "versionNonce": 150026, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "db_tab", "lineHeight": 1.25 },
    { "type": "text", "id": "db_body", "x": 1374, "y": 178, "width": 612, "height": 280, "text": "vote_packages      .salt_hex: the 32-byte salts behind every commitment, and\ninference_runs     .seal_key_hex: the AES keys of the sealed run bundles.\n                   THIS is why a database exists: published before the reveal,\n                   jurors could read each other's votes (TODO: encrypt at rest)\nresolution_events  append-only, phase-gated log; the SSE stream reads it\nclaims, committees, jury_seats, round_tallies, reveals, certificates,\npayout_tickets     a fast mirror of chain state\nevidence_*, inference_runs, tool_calls, run_approvals\n                   what chain does not hold: submitted text and URLs,\n                   per-attempt model responses, retries, redactions\nagent_manifests    the 7 seeded jurors bound to on-chain AgentProfile ids\n16 tables, lib/storage/schema.ts\n\nif Postgres is lost before a reveal, that round cannot reveal and the claim\nends UNRESOLVED; after the certificate exists, nothing here is needed", "originalText": "vote_packages      .salt_hex: the 32-byte salts behind every commitment, and\ninference_runs     .seal_key_hex: the AES keys of the sealed run bundles.\n                   THIS is why a database exists: published before the reveal,\n                   jurors could read each other's votes (TODO: encrypt at rest)\nresolution_events  append-only, phase-gated log; the SSE stream reads it\nclaims, committees, jury_seats, round_tallies, reveals, certificates,\npayout_tickets     a fast mirror of chain state\nevidence_*, inference_runs, tool_calls, run_approvals\n                   what chain does not hold: submitted text and URLs,\n                   per-attempt model responses, retries, redactions\nagent_manifests    the 7 seeded jurors bound to on-chain AgentProfile ids\n16 tables, lib/storage/schema.ts\n\nif Postgres is lost before a reveal, that round cannot reveal and the claim\nends UNRESOLVED; after the certificate exists, nothing here is needed", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 150027, "version": 1, "versionNonce": 150028, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "rule", "x": 40, "y": 450, "width": 1960, "height": 80, "strokeColor": "#b45309", "backgroundColor": "#fef3c7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 150029, "version": 1, "versionNonce": 150030, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "rule_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "rule_t", "x": 52, "y": 458, "width": 1936, "height": 64, "text": "RULE OF THUMB\nif a fact decides money or truth, it is on Sui.  if strangers must be able to re-check it, it is on Walrus with its hash on Sui.\nif it must stay secret until a deadline, it is in Postgres.  if it only makes the site fast, it is in Postgres too, and losing it costs nothing.", "originalText": "RULE OF THUMB\nif a fact decides money or truth, it is on Sui.  if strangers must be able to re-check it, it is on Walrus with its hash on Sui.\nif it must stay secret until a deadline, it is in Postgres.  if it only makes the site fast, it is in Postgres too, and losing it costs nothing.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 150031, "version": 1, "versionNonce": 150032, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "rule", "lineHeight": 1.25 }
  ],
