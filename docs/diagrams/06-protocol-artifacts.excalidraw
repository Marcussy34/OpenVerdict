  "elements": [
    { "type": "text", "id": "title", "x": 40, "y": 30, "width": 1100, "height": 35, "text": "OpenVerdict: the formulas, the wire codes, and the clock", "originalText": "OpenVerdict: the formulas, the wire codes, and the clock", "fontSize": 28, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 160001, "version": 1, "versionNonce": 160002, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "subtitle", "x": 40, "y": 74, "width": 1400, "height": 18, "text": "everything a verifier needs to recompute a verdict without trusting the website; all values are read from the code", "originalText": "everything a verifier needs to recompute a verdict without trusting the website; all values are read from the code", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 160003, "version": 1, "versionNonce": 160004, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "h_commit", "x": 40, "y": 120, "width": 800, "height": 20, "text": "1. THE COMMITMENT   (what the chain stores at commit and recomputes at reveal)", "originalText": "1. THE COMMITMENT   (what the chain stores at commit and recomputes at reveal)", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#3b82f6", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 160005, "version": 1, "versionNonce": 160006, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "rectangle", "id": "b_commit", "x": 40, "y": 150, "width": 820, "height": 135, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 160007, "version": 1, "versionNonce": 160008, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "b_commit_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "b_commit_t", "x": 56, "y": 160, "width": 788, "height": 115, "text": "// lib/protocol/commitment.ts == jury::compute_commitment (jury.move:690)\ncommitment = blake2b256(BCS(VotePreimageV1 {\n    claim_id, agent_profile_id, jury_seat_id, phase, outcome,\n    confidence_bps, evidence_root, output_hash, run_hash, salt }))\n// salt: 32 random bytes, Postgres only. reveal rebuilds the preimage from the SEAT's own ids\n// and the caller's outcome/confidence/hashes/salt, then asserts equality (jury.move:544)\n// prompt_hash inside run_hash = blake2b256(canonicalJson(PromptSpecV1)); mismatching manifests are refused", "originalText": "// lib/protocol/commitment.ts == jury::compute_commitment (jury.move:690)\ncommitment = blake2b256(BCS(VotePreimageV1 {\n    claim_id, agent_profile_id, jury_seat_id, phase, outcome,\n    confidence_bps, evidence_root, output_hash, run_hash, salt }))\n// salt: 32 random bytes, Postgres only. reveal rebuilds the preimage from the SEAT's own ids\n// and the caller's outcome/confidence/hashes/salt, then asserts equality (jury.move:544)\n// prompt_hash inside run_hash = blake2b256(canonicalJson(PromptSpecV1)); mismatching manifests are refused", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 160009, "version": 1, "versionNonce": 160010, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "b_commit", "lineHeight": 1.25 },

    { "type": "text", "id": "h_schema", "x": 900, "y": 120, "width": 800, "height": 20, "text": "2. THE MODEL OUTPUT CONTRACT   (lib/gonka/schemas.ts, zod .strict())", "originalText": "2. THE MODEL OUTPUT CONTRACT   (lib/gonka/schemas.ts, zod .strict())", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#6d28d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 160011, "version": 1, "versionNonce": 160012, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "rectangle", "id": "b_schema", "x": 900, "y": 150, "width": 820, "height": 150, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 160013, "version": 1, "versionNonce": 160014, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "b_schema_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "b_schema_t", "x": 916, "y": 160, "width": 788, "height": 130, "text": "{ \"outcome\": \"YES\" | \"NO\" | \"UNSURE\",   \"confidenceBps\": 0..10000,\n  \"evidenceFor\": [ids], \"evidenceAgainst\": [ids],\n  \"unsupportedClaims\": [ids], \"decisiveEvidence\": [ids],\n  \"reasoning\": <= 4000 UTF-8 bytes,\n  \"publicReasoningTrace\": 1..8 x { \"check\", \"evidenceIds\", \"finding\",\n         \"assessment\": SUPPORTS | CONTRADICTS | MIXED | INSUFFICIENT } }\n// anything else, or a cited evidenceId absent from the frozen manifest, is NO_VALID_INFERENCE:\n// the run is rejected and the seat casts no vote (fail closed)", "originalText": "{ \"outcome\": \"YES\" | \"NO\" | \"UNSURE\",   \"confidenceBps\": 0..10000,\n  \"evidenceFor\": [ids], \"evidenceAgainst\": [ids],\n  \"unsupportedClaims\": [ids], \"decisiveEvidence\": [ids],\n  \"reasoning\": <= 4000 UTF-8 bytes,\n  \"publicReasoningTrace\": 1..8 x { \"check\", \"evidenceIds\", \"finding\",\n         \"assessment\": SUPPORTS | CONTRADICTS | MIXED | INSUFFICIENT } }\n// anything else, or a cited evidenceId absent from the frozen manifest, is NO_VALID_INFERENCE:\n// the run is rejected and the seat casts no vote (fail closed)", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 160015, "version": 1, "versionNonce": 160016, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "b_schema", "lineHeight": 1.25 },

    { "type": "text", "id": "h_score", "x": 40, "y": 300, "width": 800, "height": 20, "text": "3. THE TRUTH SCORE   (lib/protocol/truthScore.ts == jury::truth_score_bps)", "originalText": "3. THE TRUTH SCORE   (lib/protocol/truthScore.ts == jury::truth_score_bps)", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#3b82f6", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 160017, "version": 1, "versionNonce": 160018, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "rectangle", "id": "b_score", "x": 40, "y": 330, "width": 820, "height": 105, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 160019, "version": 1, "versionNonce": 160020, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "b_score_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "b_score_t", "x": 56, "y": 340, "width": 788, "height": 85, "text": "per vote:  YES -> confidenceBps    NO -> 10000 - confidenceBps    UNSURE -> 5000\nscore_bps = (sum + floor(n / 2)) / n        // half-up integer mean, unweighted\n// final valid round only; 4 of 5 matching votes (denominator = committee size) finalize YES / NO,\n// 4 of 5 UNSURE or no threshold after round two -> UNRESOLVED\n// demo 2026-08-27: 5 reveals, YES @ 9700 bps; off-chain recompute == certificate 0x8efdabe0...1a8634", "originalText": "per vote:  YES -> confidenceBps    NO -> 10000 - confidenceBps    UNSURE -> 5000\nscore_bps = (sum + floor(n / 2)) / n        // half-up integer mean, unweighted\n// final valid round only; 4 of 5 matching votes (denominator = committee size) finalize YES / NO,\n// 4 of 5 UNSURE or no threshold after round two -> UNRESOLVED\n// demo 2026-08-27: 5 reveals, YES @ 9700 bps; off-chain recompute == certificate 0x8efdabe0...1a8634", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 160021, "version": 1, "versionNonce": 160022, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "b_score", "lineHeight": 1.25 },

    { "type": "text", "id": "h_codes", "x": 900, "y": 330, "width": 800, "height": 20, "text": "4. THE WIRE CODES   (lib/protocol/constants.ts == the Move modules)", "originalText": "4. THE WIRE CODES   (lib/protocol/constants.ts == the Move modules)", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#3b82f6", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 160023, "version": 1, "versionNonce": 160024, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "rectangle", "id": "b_codes", "x": 900, "y": 360, "width": 820, "height": 105, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 160025, "version": 1, "versionNonce": 160026, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "b_codes_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "b_codes_t", "x": 916, "y": 370, "width": 788, "height": 85, "text": "claim state u8:  CREATED=0 PROPOSED=1 CHALLENGED=2 REVIEW_REQUESTED=3 COMMIT_1=4 REVEAL_1=5 DISCUSSION=6\n                 COMMIT_2=7 REVEAL_2=8 FINALIZED_UNCHALLENGED=9 FINALIZED_REVIEWED=10 UNRESOLVED=11 CANCELLED=12\noutcome u8:      NONE=0 YES=1 NO=2 UNSURE=3; a claim result adds UNRESOLVED=4\nmode u8:         DIRECT_REVIEW=1 (the fact checker)  OPTIMISTIC_SETTLEMENT=2 (propose, challenge, jury)\nseat status:     OFFERED=0 ACCEPTED=1 COMMITTED=2 DECLINED=3;  committee 5, threshold 4, reserves 2", "originalText": "claim state u8:  CREATED=0 PROPOSED=1 CHALLENGED=2 REVIEW_REQUESTED=3 COMMIT_1=4 REVEAL_1=5 DISCUSSION=6\n                 COMMIT_2=7 REVEAL_2=8 FINALIZED_UNCHALLENGED=9 FINALIZED_REVIEWED=10 UNRESOLVED=11 CANCELLED=12\noutcome u8:      NONE=0 YES=1 NO=2 UNSURE=3; a claim result adds UNRESOLVED=4\nmode u8:         DIRECT_REVIEW=1 (the fact checker)  OPTIMISTIC_SETTLEMENT=2 (propose, challenge, jury)\nseat status:     OFFERED=0 ACCEPTED=1 COMMITTED=2 DECLINED=3;  committee 5, threshold 4, reserves 2", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 160027, "version": 1, "versionNonce": 160028, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "b_codes", "lineHeight": 1.25 },

    { "type": "text", "id": "h_clock", "x": 40, "y": 500, "width": 1200, "height": 20, "text": "5. THE CLOCK   (defaultDeadlines in lib/engine/engine.ts for testnet; the floors are asserted in Move)", "originalText": "5. THE CLOCK   (defaultDeadlines in lib/engine/engine.ts for testnet; the floors are asserted in Move)", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#3b82f6", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 160029, "version": 1, "versionNonce": 160030, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
