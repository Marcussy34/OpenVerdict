   "link": null,
   "locked": false,
   "fontSize": 11,
   "fontFamily": 3,
   "text": "commitment = blake2b256(BCS(VotePreimageV1 {\n  claim_id, agent_profile_id, jury_seat_id,\n  phase, outcome, confidence_bps,\n  evidence_root, output_hash, run_hash, salt }))\n\nsalt: 32 random bytes, engine-held\nreveal must reproduce EXACT bytes on-chain",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "commitment = blake2b256(BCS(VotePreimageV1 {\n  claim_id, agent_profile_id, jury_seat_id,\n  phase, outcome, confidence_bps,\n  evidence_root, output_hash, run_hash, salt }))\n\nsalt: 32 random bytes, engine-held\nreveal must reproduce EXACT bytes on-chain",
   "lineHeight": 1.25,
   "baseline": 11
