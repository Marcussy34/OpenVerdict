    { "type": "text", "id": "vercel_t", "x": 330, "y": 170, "width": 440, "height": 70, "text": "Vercel project open-verdict (Next.js pages + /api/*)\nalias open-verdict-nine.vercel.app\nserverless functions: request side of the engine only\nNEXT_PUBLIC_* env is baked in at build time", "originalText": "Vercel project open-verdict (Next.js pages + /api/*)\nalias open-verdict-nine.vercel.app\nserverless functions: request side of the engine only\nNEXT_PUBLIC_* env is baked in at build time", "fontSize": 12, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 170015, "version": 1, "versionNonce": 170016, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "vercel", "lineHeight": 1.25 },
