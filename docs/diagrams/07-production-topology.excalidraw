    { "type": "text", "id": "browser_t", "x": 50, "y": 180, "width": 200, "height": 50, "text": "browser\nhttps://openverdict.info\napex + www, NS on Vercel", "originalText": "browser\nhttps://openverdict.info\napex + www, NS on Vercel", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 170009, "version": 1, "versionNonce": 170010, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "browser", "lineHeight": 1.25 },
