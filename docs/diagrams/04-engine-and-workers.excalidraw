    { "type": "text", "id": "req_title", "x": 40, "y": 270, "width": 400, "height": 20, "text": "REQUEST SIDE   called by app/api routes", "originalText": "REQUEST SIDE   called by app/api routes", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#3b82f6", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140013, "version": 1, "versionNonce": 140014, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "req_list", "x": 40, "y": 298, "width": 400, "height": 163, "text": "factCheckStart   create Claim on Sui + ingest URLs\nclaimCreate      operator-only economic claims\nlistClaims / inspect / report\nevents           SSE async generator\nlistAgents\nregisterZkBackedAgent   zkLogin-backed seat\nstatus           what /api/status returns\n\nall RETURN QUICKLY; none advance a claim", "originalText": "factCheckStart   create Claim on Sui + ingest URLs\nclaimCreate      operator-only economic claims\nlistClaims / inspect / report\nevents           SSE async generator\nlistAgents\nregisterZkBackedAgent   zkLogin-backed seat\nstatus           what /api/status returns\n\nall RETURN QUICKLY; none advance a claim", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140015, "version": 1, "versionNonce": 140016, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "line", "id": "split", "x": 455, "y": 270, "width": 0, "height": 190, "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140017, "version": 1, "versionNonce": 140018, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "points": [[0, 0], [0, 190]] },
    { "type": "text", "id": "life_title", "x": 470, "y": 270, "width": 410, "height": 20, "text": "LIFECYCLE SIDE   workers, CLI, scripts only", "originalText": "LIFECYCLE SIDE   workers, CLI, scripts only", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#3b82f6", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140019, "version": 1, "versionNonce": 140020, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "life_list", "x": 470, "y": 298, "width": 410, "height": 163, "text": "selectCommittee  draw 5 seats with Sui Random\nevidenceFreeze   fetch -> Walrus -> Merkle -> Sui\njuryRun          5 GonkaRouter calls + validation\nvotesCommit      hash(vote, salt) on each JurySeat\nvotesReveal      preimage on chain, tally\nadvance          next phase (deadline-gated)\nfinalize         certificate + Truth Score\n\neach signs Sui transactions (operator / agent keys)", "originalText": "selectCommittee  draw 5 seats with Sui Random\nevidenceFreeze   fetch -> Walrus -> Merkle -> Sui\njuryRun          5 GonkaRouter calls + validation\nvotesCommit      hash(vote, salt) on each JurySeat\nvotesReveal      preimage on chain, tally\nadvance          next phase (deadline-gated)\nfinalize         certificate + Truth Score\n\neach signs Sui transactions (operator / agent keys)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140021, "version": 1, "versionNonce": 140022, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "wk_title", "x": 40, "y": 500, "width": 840, "height": 20, "text": "WHO CALLS THE LIFECYCLE SIDE: three workers, each a poll loop (workers/runtime.ts)", "originalText": "WHO CALLS THE LIFECYCLE SIDE: three workers, each a poll loop (workers/runtime.ts)", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#3b82f6", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140023, "version": 1, "versionNonce": 140024, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "wk_ev", "x": 40, "y": 540, "width": 260, "height": 60, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140025, "version": 1, "versionNonce": 140026, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "wk_ev_t", "type": "text" }, { "id": "wk_a1", "type": "arrow" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "wk_ev_t", "x": 50, "y": 550, "width": 240, "height": 40, "text": "evidence-worker.ts\nengine.evidenceFreeze", "originalText": "evidence-worker.ts\nengine.evidenceFreeze", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140027, "version": 1, "versionNonce": 140028, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "wk_ev", "lineHeight": 1.25 },
    { "type": "text", "id": "wk_ev_d", "x": 40, "y": 610, "width": 260, "height": 60, "text": "claims that still need a phase-1\nor phase-2 bundle; the fetching\nitself stays inside the engine", "originalText": "claims that still need a phase-1\nor phase-2 bundle; the fetching\nitself stays inside the engine", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140029, "version": 1, "versionNonce": 140030, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "arrow", "id": "wk_a1", "x": 302, "y": 570, "width": 26, "height": 0, "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140031, "version": 1, "versionNonce": 140032, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "points": [[0, 0], [26, 0]], "startBinding": { "elementId": "wk_ev", "focus": 0, "gap": 2 }, "endBinding": { "elementId": "wk_inf", "focus": 0, "gap": 2 }, "startArrowhead": null, "endArrowhead": "arrow" },
    { "type": "rectangle", "id": "wk_inf", "x": 330, "y": 540, "width": 260, "height": 60, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140033, "version": 1, "versionNonce": 140034, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "wk_inf_t", "type": "text" }, { "id": "wk_a1", "type": "arrow" }, { "id": "wk_a2", "type": "arrow" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "wk_inf_t", "x": 340, "y": 550, "width": 240, "height": 40, "text": "inference-worker.ts\njuryRun, then votesCommit", "originalText": "inference-worker.ts\njuryRun, then votesCommit", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140035, "version": 1, "versionNonce": 140036, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "wk_inf", "lineHeight": 1.25 },
    { "type": "text", "id": "wk_inf_d", "x": 330, "y": 610, "width": 260, "height": 60, "text": "COMMIT_1 / COMMIT_2 claims whose\nevidence root is frozen; an\ninvalid model run is NOT a vote", "originalText": "COMMIT_1 / COMMIT_2 claims whose\nevidence root is frozen; an\ninvalid model run is NOT a vote", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140037, "version": 1, "versionNonce": 140038, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "arrow", "id": "wk_a2", "x": 592, "y": 570, "width": 26, "height": 0, "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140039, "version": 1, "versionNonce": 140040, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "points": [[0, 0], [26, 0]], "startBinding": { "elementId": "wk_inf", "focus": 0, "gap": 2 }, "endBinding": { "elementId": "wk_res", "focus": 0, "gap": 2 }, "startArrowhead": null, "endArrowhead": "arrow" },
    { "type": "rectangle", "id": "wk_res", "x": 620, "y": 540, "width": 260, "height": 60, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140041, "version": 1, "versionNonce": 140042, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "wk_res_t", "type": "text" }, { "id": "wk_a2", "type": "arrow" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "wk_res_t", "x": 630, "y": 550, "width": 240, "height": 40, "text": "resolution-worker.ts\nroutes by claim state", "originalText": "resolution-worker.ts\nroutes by claim state", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140043, "version": 1, "versionNonce": 140044, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "wk_res", "lineHeight": 1.25 },
    { "type": "text", "id": "wk_res_d", "x": 620, "y": 610, "width": 260, "height": 75, "text": "REVIEW_REQUESTED: selectCommittee\nCOMMIT_n: advance (after deadline)\nREVEAL_n: votesReveal, then\n  finalize (after reveal deadline)\nDISCUSSION: advance, else finalize", "originalText": "REVIEW_REQUESTED: selectCommittee\nCOMMIT_n: advance (after deadline)\nREVEAL_n: votesReveal, then\n  finalize (after reveal deadline)\nDISCUSSION: advance, else finalize", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140045, "version": 1, "versionNonce": 140046, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "arrow", "id": "wk_loop", "x": 750, "y": 700, "width": 580, "height": 30, "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140047, "version": 1, "versionNonce": 140048, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "points": [[0, 0], [0, 30], [-580, 30], [-580, 0]], "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow" },
    { "type": "text", "id": "wk_loop_t", "x": 190, "y": 740, "width": 560, "height": 45, "text": "every tick: engine.listClaims(), then act; poll every 2 s\n(OPENVERDICT_WORKER_POLL_MS). With Postgres, pg_advisory_lock serialises\nticks across all three: one Sui operator signer, one writer at a time.", "originalText": "every tick: engine.listClaims(), then act; poll every 2 s\n(OPENVERDICT_WORKER_POLL_MS). With Postgres, pg_advisory_lock serialises\nticks across all three: one Sui operator signer, one writer at a time.", "fontSize": 12, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140049, "version": 1, "versionNonce": 140050, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "warn", "x": 40, "y": 810, "width": 840, "height": 110, "strokeColor": "#dc2626", "backgroundColor": "#fee2e2", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140051, "version": 1, "versionNonce": 140052, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "warn_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "warn_t", "x": 50, "y": 820, "width": 820, "height": 90, "text": "NOT RUNNING IN PRODUCTION TODAY\nThe workers are launched only by scripts/start-production.mjs (Dockerfile / railway.json).\nVercel runs only the request side: no cron, no tick route. A claim submitted on openverdict.info is\ncreated on Sui, its evidence ingested, then waits at REVIEW_REQUESTED until a worker host exists.", "originalText": "NOT RUNNING IN PRODUCTION TODAY\nThe workers are launched only by scripts/start-production.mjs (Dockerfile / railway.json).\nVercel runs only the request side: no cron, no tick route. A claim submitted on openverdict.info is\ncreated on Sui, its evidence ingested, then waits at REVIEW_REQUESTED until a worker host exists.", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#b91c1c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140053, "version": 1, "versionNonce": 140054, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "warn", "lineHeight": 1.25 },

    { "type": "rectangle", "id": "db", "x": 40, "y": 960, "width": 400, "height": 70, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140055, "version": 1, "versionNonce": 140056, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "db_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "db_t", "x": 50, "y": 970, "width": 380, "height": 50, "text": "Neon Postgres (drizzle, lib/storage)\nDATABASE_URL; PGlite fallback for dev/tests", "originalText": "Neon Postgres (drizzle, lib/storage)\nDATABASE_URL; PGlite fallback for dev/tests", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140057, "version": 1, "versionNonce": 140058, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "db", "lineHeight": 1.25 },
    { "type": "text", "id": "db_note", "x": 40, "y": 1040, "width": 400, "height": 65, "text": "the engine's private working memory: claim\nmirror, committee, run audits, the append-only\nresolution_events log (what the SSE reads), and\nvote_packages.salt_hex: the commit-reveal salts", "originalText": "the engine's private working memory: claim\nmirror, committee, run audits, the append-only\nresolution_events log (what the SSE reads), and\nvote_packages.salt_hex: the commit-reveal salts", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140059, "version": 1, "versionNonce": 140060, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "sse", "x": 480, "y": 960, "width": 400, "height": 70, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140061, "version": 1, "versionNonce": 140062, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "sse_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "sse_t", "x": 490, "y": 970, "width": 380, "height": 50, "text": "event stream (lib/events)\nengine.events(claimId, fromSequence)", "originalText": "event stream (lib/events)\nengine.events(claimId, fromSequence)", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140063, "version": 1, "versionNonce": 140064, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "sse", "lineHeight": 1.25 },
    { "type": "text", "id": "sse_note", "x": 480, "y": 1040, "width": 400, "height": 65, "text": "polls resolution_events and serialises each\nrow via serializePublicEvent: PUBLIC_NOW is\nsent, PUBLIC_AFTER_REVEAL waits for the\nreveal, INTERNAL_REDACTED never leaves", "originalText": "polls resolution_events and serialises each\nrow via serializePublicEvent: PUBLIC_NOW is\nsent, PUBLIC_AFTER_REVEAL waits for the\nreveal, INTERNAL_REDACTED never leaves", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140065, "version": 1, "versionNonce": 140066, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "rules", "x": 40, "y": 1130, "width": 840, "height": 170, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140067, "version": 1, "versionNonce": 140068, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "rules_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "rules_t", "x": 56, "y": 1142, "width": 808, "height": 146, "text": "// hard rules the engine enforces (CLAUDE.md + PRD)\nmodels never receive URLs, keys, or transaction authority   // the engine fetches; the model only reads\nsalts never leave the engine                  // vote_packages.salt_hex; never on Sui or Walrus\nmalformed model output is never a vote        // zod; cited evidenceIds must exist in the frozen manifest\nthe observer has NO signer                    // it cannot move funds, vote, or advance phases\nu8 state codes: one shared Move/TS wire contract; never renumber one side alone\n   CREATED=0 PROPOSED=1 CHALLENGED=2 REVIEW_REQUESTED=3 COMMIT_1=4 REVEAL_1=5 DISCUSSION=6 COMMIT_2=7\n   REVEAL_2=8 FINALIZED_UNCHALLENGED=9 FINALIZED_REVIEWED=10 UNRESOLVED=11 CANCELLED=12", "originalText": "// hard rules the engine enforces (CLAUDE.md + PRD)\nmodels never receive URLs, keys, or transaction authority   // the engine fetches; the model only reads\nsalts never leave the engine                  // vote_packages.salt_hex; never on Sui or Walrus\nmalformed model output is never a vote        // zod; cited evidenceIds must exist in the frozen manifest\nthe observer has NO signer                    // it cannot move funds, vote, or advance phases\nu8 state codes: one shared Move/TS wire contract; never renumber one side alone\n   CREATED=0 PROPOSED=1 CHALLENGED=2 REVIEW_REQUESTED=3 COMMIT_1=4 REVEAL_1=5 DISCUSSION=6 COMMIT_2=7\n   REVEAL_2=8 FINALIZED_UNCHALLENGED=9 FINALIZED_REVIEWED=10 UNRESOLVED=11 CANCELLED=12", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140069, "version": 1, "versionNonce": 140070, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "rules", "lineHeight": 1.25 }
  ],
