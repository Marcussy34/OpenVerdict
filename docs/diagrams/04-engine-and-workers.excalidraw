    { "type": "text", "id": "title", "x": 40, "y": 30, "width": 900, "height": 35, "text": "OpenVerdict: the engine seam and who drives it", "originalText": "OpenVerdict: the engine seam and who drives it", "fontSize": 28, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140001, "version": 1, "versionNonce": 140002, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "subtitle", "x": 40, "y": 74, "width": 900, "height": 18, "text": "lib/engine/engine.ts behind the seam lib/engine/contract.ts; one singleton per process (Vercel, worker, CLI)", "originalText": "lib/engine/engine.ts behind the seam lib/engine/contract.ts; one singleton per process (Vercel, worker, CLI)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140003, "version": 1, "versionNonce": 140004, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "hero", "x": 40, "y": 120, "width": 840, "height": 80, "strokeColor": "#1e3a5f", "backgroundColor": "#3b82f6", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140005, "version": 1, "versionNonce": 140006, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "hero_t", "type": "text" }, { "id": "a_req", "type": "arrow" }, { "id": "a_life", "type": "arrow" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "hero_t", "x": 50, "y": 130, "width": 820, "height": 60, "text": "OpenVerdictEngine  (createEngine)\nthe court clerk: signs as the operator and the 7 agents, keeps the salts, never decides", "originalText": "OpenVerdictEngine  (createEngine)\nthe court clerk: signs as the operator and the 7 agents, keeps the salts, never decides", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 140007, "version": 1, "versionNonce": 140008, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "hero", "lineHeight": 1.25 },

