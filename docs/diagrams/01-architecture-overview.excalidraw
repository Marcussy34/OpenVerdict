    { "type": "text", "id": "engine_t", "x": 830, "y": 230, "width": 300, "height": 190, "text": "OpenVerdictEngine\nlib/engine, seam: contract.ts\n\nthe court clerk:\ncreates claims, freezes evidence,\nruns the jury, signs every Sui\ntransaction with the operator key\nand 7 agent keys, keeps the salts,\nnever decides the answer", "originalText": "OpenVerdictEngine\nlib/engine, seam: contract.ts\n\nthe court clerk:\ncreates claims, freezes evidence,\nruns the jury, signs every Sui\ntransaction with the operator key\nand 7 agent keys, keeps the salts,\nnever decides the answer", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 110071, "version": 1, "versionNonce": 110072, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "engine", "lineHeight": 1.25 },

