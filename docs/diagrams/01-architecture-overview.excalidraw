    { "type": "text", "id": "neon_t", "x": 830, "y": 500, "width": 300, "height": 70, "text": "Neon Postgres (drizzle, 16 tables)\nshared by every engine process:\nclaim mirror, run audits, event log,\nand the commit-reveal salts", "originalText": "Neon Postgres (drizzle, 16 tables)\nshared by every engine process:\nclaim mirror, run audits, event log,\nand the commit-reveal salts", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 110077, "version": 1, "versionNonce": 110078, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "neon", "lineHeight": 1.25 },

