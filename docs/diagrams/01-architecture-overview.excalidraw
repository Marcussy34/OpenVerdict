    { "type": "text", "id": "vercel_t", "x": 470, "y": 170, "width": 280, "height": 90, "text": "Vercel: Next.js 16\nproject open-verdict\n15 pages + 9 /api/* routes\nas serverless functions\nREQUEST side of the engine only", "originalText": "Vercel: Next.js 16\nproject open-verdict\n15 pages + 9 /api/* routes\nas serverless functions\nREQUEST side of the engine only", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 110049, "version": 1, "versionNonce": 110050, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "vercel", "lineHeight": 1.25 },

    { "type": "rectangle", "id": "workers", "x": 460, "y": 330, "width": 300, "height": 130, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 110051, "version": 1, "versionNonce": 110052, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "workers_t", "type": "text" }, { "id": "a_workers", "type": "arrow" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "workers_t", "x": 470, "y": 340, "width": 280, "height": 110, "text": "3 workers: evidence,\ninference, resolution\npoll every 2 s under one\nPostgres advisory lock\nLIFECYCLE side: select, freeze,\ninfer, commit, reveal, finalize", "originalText": "3 workers: evidence,\ninference, resolution\npoll every 2 s under one\nPostgres advisory lock\nLIFECYCLE side: select, freeze,\ninfer, commit, reveal, finalize", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 110053, "version": 1, "versionNonce": 110054, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "workers", "lineHeight": 1.25 },
    { "type": "rectangle", "id": "workers_warn", "x": 460, "y": 470, "width": 300, "height": 50, "strokeColor": "#dc2626", "backgroundColor": "#fee2e2", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "angle": 0, "seed": 110055, "version": 1, "versionNonce": 110056, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "workers_warn_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "workers_warn_t", "x": 470, "y": 478, "width": 280, "height": 34, "text": "NOT RUNNING IN PRODUCTION:\nnothing on Vercel launches them", "originalText": "NOT RUNNING IN PRODUCTION:\nnothing on Vercel launches them", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#b91c1c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 110057, "version": 1, "versionNonce": 110058, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "workers_warn", "lineHeight": 1.25 },

