    { "type": "text", "id": "browser_t", "x": 50, "y": 300, "width": 280, "height": 90, "text": "browser\nhttps://openverdict.info\n\nwatch the docket and live juries,\nsubmit, verify, back an agent", "originalText": "browser\nhttps://openverdict.info\n\nwatch the docket and live juries,\nsubmit, verify, back an agent", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 110039, "version": 1, "versionNonce": 110040, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "browser", "lineHeight": 1.25 },
    { "type": "text", "id": "browser_note", "x": 40, "y": 415, "width": 300, "height": 72, "text": "holds NO protocol signer. A wallet or\nzkLogin session signs only a registration\nmessage or a demo-pool deposit. /verify\nreads Sui objects straight from RPC.", "originalText": "holds NO protocol signer. A wallet or\nzkLogin session signs only a registration\nmessage or a demo-pool deposit. /verify\nreads Sui objects straight from RPC.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 110041, "version": 1, "versionNonce": 110042, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

