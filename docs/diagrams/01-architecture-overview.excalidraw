    { "type": "text", "id": "a_gonka_t", "x": 1148, "y": 178, "width": 90, "height": 30, "text": "5 inferences\nper claim", "originalText": "5 inferences\nper claim", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#6d28d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 110081, "version": 1, "versionNonce": 110082, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
