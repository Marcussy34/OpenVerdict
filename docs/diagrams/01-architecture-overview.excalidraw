    { "type": "text", "id": "title", "x": 40, "y": 30, "width": 900, "height": 35, "text": "OpenVerdict: architecture at a glance", "originalText": "OpenVerdict: architecture at a glance", "fontSize": 28, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 110001, "version": 1, "versionNonce": 110002, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "subtitle", "x": 40, "y": 74, "width": 1100, "height": 36, "text": "Sui is the only authority. Walrus is the public filing cabinet. Postgres is the engine's private notebook.\nThe browser can watch everything but sign nothing; the engine holds the keys.", "originalText": "Sui is the only authority. Walrus is the public filing cabinet. Postgres is the engine's private notebook.\nThe browser can watch everything but sign nothing; the engine holds the keys.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 110003, "version": 1, "versionNonce": 110004, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

